# Copy this file to .env and fill in your own values. Never commit .env.
APP_NAME=IT-HAMS
APP_ENV=local
APP_URL=http://localhost:3002
APP_PORT=3002
# Any long random text, e.g. run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=it_hams_v3
# Your local PostgreSQL user and password (the one you set when installing PostgreSQL, usually "postgres").
DB_USER=postgres
DB_PASS=your-postgres-password

# Optional: SMTP password for allocation emails (otherwise set in Settings > Notifications).
# SMTP_PASSWORD=
