<div class="min-h-[60vh] flex items-center justify-center">
  <div class="text-center max-w-md">
    <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-rose-500/15 text-rose-400 flex items-center justify-center">
      <i data-lucide="alert-octagon" class="w-8 h-8"></i>
    </div>
    <h1 class="font-heading text-3xl font-bold text-white mb-2"><%= typeof statusCode !== 'undefined' ? statusCode : 500 %></h1>
    <p class="text-slate-400 mb-6"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred.' %></p>
    <a href="<%= hams_url('/') %>" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium">
      <i data-lucide="arrow-left" class="w-4 h-4"></i>Back to Dashboard
    </a>
  </div>
</div>
