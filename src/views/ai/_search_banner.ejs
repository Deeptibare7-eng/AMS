<%# Smart search on Hardware (only while "Smart search" is on): what the search understood. %>
<div class="mb-6 -mt-3 px-4 py-3 rounded-2xl bg-blue-500/5 border border-blue-500/15 text-xs text-slate-400 flex flex-wrap items-center gap-x-3 gap-y-1.5">
  <span class="flex items-center gap-1.5 text-blue-300 font-medium"><i data-lucide="sparkles" class="w-3.5 h-3.5"></i>Smart search</span>
  <span>Best matches first, across tag, serial, host name, FAMS barcode, CTID, model, location and specs.</span>
  <% for (const line of banner.lines) { %><span class="px-2 py-0.5 rounded-lg bg-white/5 text-slate-300"><%= line %></span><% } %>
  <% if (banner.partial) { %><span class="px-2 py-0.5 rounded-lg bg-amber-500/10 text-amber-300"><%= banner.partial %></span><% } %>
</div>
