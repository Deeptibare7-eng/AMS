<div x-data="{ retentionOpen: false }">
<div class="flex flex-wrap items-center justify-between gap-4 mb-8">
  <div>
    <h1 class="font-heading text-2xl md:text-3xl font-bold text-white">Archive</h1>
    <p class="text-sm text-slate-500 mt-1">Soft-deleted records — purged automatically after <%= retention_days %> day(s)</p>
  </div>
  <button @click="retentionOpen = true" class="px-5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-sm text-slate-300">Retention Policy</button>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <% for (const [key, group] of Object.entries(groups)) { %>
  <div class="bg-hams-card border border-white/5 rounded-3xl p-6">
    <h2 class="font-heading font-semibold text-white mb-4"><%= group.label %> <span class="text-xs text-slate-500">(<%= group.items.length %>)</span></h2>
    <div class="space-y-2">
      <% for (const item of group.items) { %>
      <div class="flex items-center justify-between p-3 rounded-xl bg-white/[.02]">
        <div>
          <div class="text-sm text-white"><%= item.name %></div>
          <div class="text-xs text-slate-500">Deleted <%= formatDateTime(item.deleted_at) %></div>
        </div>
        <form method="POST" action="<%= hams_url('/archive/' + key + '/' + item.id + '/restore') %>">
          <%- csrf_field %>
          <button class="px-3 py-1.5 rounded-lg bg-emerald-600/15 text-emerald-400 hover:bg-emerald-600/25 text-xs">Restore</button>
        </form>
      </div>
      <% } %>
      <% if (!group.items.length) { %><p class="text-xs text-slate-500 py-2">No archived records.</p><% } %>
    </div>
  </div>
  <% } %>
</div>

<div x-show="retentionOpen" x-cloak class="fixed inset-0 z-[90] flex items-center justify-center px-4">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" @click="retentionOpen = false"></div>
  <div class="relative bg-hams-card border border-white/10 rounded-3xl p-6 w-full max-w-sm">
    <h3 class="font-heading font-semibold text-white mb-4">Archive Retention Policy</h3>
    <form method="POST" action="<%= hams_url('/archive/settings') %>" class="space-y-4">
      <%- csrf_field %>
      <div>
        <label class="block text-xs font-medium text-slate-400 mb-1.5">Retention Days (1–3650)</label>
        <input type="number" name="retention_days" min="1" max="3650" value="<%= retention_days %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
      </div>
      <p class="text-xs text-slate-500">Soft-deleted records older than this are permanently purged when the archive page loads or via the CLI.</p>
      <div class="flex justify-end gap-2">
        <button type="button" @click="retentionOpen = false" class="px-4 py-2 rounded-xl bg-white/5 text-sm text-slate-300">Cancel</button>
        <button type="submit" class="px-4 py-2 rounded-xl bg-blue-600 text-sm text-white font-medium">Save Policy</button>
      </div>
    </form>
  </div>
</div>
</div>
