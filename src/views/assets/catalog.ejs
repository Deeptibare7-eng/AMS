<div class="mb-8">
  <h1 class="font-heading text-2xl md:text-3xl font-bold text-white">Inventory Setup</h1>
  <p class="text-sm text-slate-500 mt-1">Foundation records that power asset and inventory workflows</p>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
  <% for (const card of cards) { %>
  <a href="<%= hams_url(card.type === 'departments' ? '/inventory-setup/departments' : '/inventory-setup/' + card.type) %>"
     class="bg-hams-card border border-white/5 rounded-3xl p-6 hover:border-blue-500/30 transition group">
    <div class="flex items-start justify-between mb-4">
      <span class="w-11 h-11 rounded-2xl bg-blue-500/10 text-blue-400 flex items-center justify-center group-hover:bg-blue-500/20"><i data-lucide="<%= card.icon %>" class="w-5 h-5"></i></span>
      <span class="text-2xl font-bold text-white font-heading"><%= card.count %></span>
    </div>
    <div class="font-semibold text-white mb-1"><%= card.title %></div>
    <p class="text-xs text-slate-500 leading-relaxed"><%= card.description %></p>
  </a>
  <% } %>
</div>
