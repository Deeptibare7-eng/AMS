<div class="max-w-6xl">
<div class="flex items-center gap-3 mb-8">
  <a href="<%= hams_url('/assets/' + asset.id) %>" class="p-2 rounded-xl hover:bg-white/5 text-slate-400"><i data-lucide="arrow-left" class="w-5 h-5"></i></a>
  <div>
    <h1 class="font-heading text-2xl md:text-3xl font-bold text-white">Edit Asset</h1>
    <p class="text-sm text-slate-500 mt-1 font-mono"><%= asset.asset_tag %></p>
  </div>
</div>

<form method="POST" action="<%= hams_url('/assets/' + asset.id + '/update') %>" id="edit-asset-form">
  <%- csrf_field %>
  <input type="hidden" name="status" value="<%= asset.status %>">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 bg-hams-card border border-white/5 rounded-3xl p-6">
      <h2 class="font-heading font-semibold text-white mb-5">Core Identity</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1.5">Asset Tag *</label>
          <input type="text" name="asset_tag" required value="<%= asset.asset_tag %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm font-mono">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1.5">Name *</label>
          <input type="text" name="name" required value="<%= asset.name %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1.5">Serial Number</label>
          <div class="relative">
            <input type="text" name="serial_number" value="<%= asset.serial_number || '' %>" class="w-full px-4 py-2.5 pr-11 rounded-xl bg-hams-bg border border-white/10 text-sm font-mono">
            <button type="button" data-barcode-scan="serial_number" class="absolute right-2 top-1/2 -translate-y-1/2 p-1.5 rounded-lg hover:bg-white/5 text-slate-400"><i data-lucide="scan-barcode" class="w-4 h-4"></i></button>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1.5">Model Number</label>
          <input type="text" name="model_number" value="<%= asset.model_number || '' %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
        </div>
        <% const selects = [
          ['asset_model_id', 'Asset Model', references.models, asset.asset_model_id],
          ['category_id', 'Category', references.categories, asset.category_id],
          ['manufacturer_id', 'Manufacturer', references.manufacturers, asset.manufacturer_id],
          ['supplier_id', 'Supplier', references.suppliers, asset.supplier_id],
          ['status_label_id', 'Status Label', references.status_labels, asset.status_label_id]
        ]; %>
        <% for (const [name, label, options, value] of selects) { %>
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1.5"><%= label %></label>
          <select name="<%= name %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
            <option value="">— None —</option>
            <% for (const o of options) { %><option value="<%= o.id %>" <%= String(value) === String(o.id) ? 'selected' : '' %>><%= o.name %></option><% } %>
          </select>
        </div>
        <% } %>
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1.5">Location</label>
          <select name="location_id" id="edit_location_id" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
            <option value="">— None —</option>
            <% for (const l of references.locations) { %><option value="<%= l.id %>" <%= String(asset.location_id) === String(l.id) ? 'selected' : '' %>><%= l.name %></option><% } %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1.5">Sub-Location</label>
          <select name="sub_location_id" id="edit_sub_location_id" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
            <option value="">— None —</option>
          </select>
        </div>
      </div>
    </div>
    <aside class="space-y-6">
      <div class="bg-hams-card border border-white/5 rounded-3xl p-6 space-y-4">
        <h2 class="font-heading font-semibold text-white">Lifecycle</h2>
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1.5">Purchase Date</label>
          <input type="date" name="purchase_date" value="<%= formatDate(asset.purchase_date) %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1.5">Purchase Cost</label>
          <input type="number" step="0.01" name="purchase_cost" value="<%= asset.purchase_cost || '' %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1.5">Warranty Expiry</label>
          <input type="date" name="warranty_expiry" value="<%= formatDate(asset.warranty_expiry) %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1.5">Procurement Record</label>
          <select name="procurement_id" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
            <option value="">No procurement record</option>
            <% for (const p of references.procurement) { %>
            <option value="<%= p.id %>" <%= String(asset.procurement_id) === String(p.id) ? 'selected' : '' %>>PO: <%= p.po_number || '—' %> / Inv: <%= p.invoice_number || '—' %></option>
            <% } %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1.5">Notes</label>
          <textarea name="notes" rows="3" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"><%= asset.notes || '' %></textarea>
        </div>
      </div>
      <div class="flex flex-col gap-3">
        <button type="submit" class="w-full py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold">Save Changes</button>
        <a href="<%= hams_url('/assets/' + asset.id) %>" class="w-full py-3 rounded-xl bg-white/5 hover:bg-white/10 text-center text-sm text-slate-300">Cancel</a>
      </div>
    </aside>
  </div>
</form>
<form method="POST" action="<%= hams_url('/assets/' + asset.id + '/delete') %>" data-confirm="Delete this asset?" class="mt-4">
  <%- csrf_field %>
  <button class="text-sm text-rose-400 hover:underline">Delete Asset</button>
</form>

<script>
(function() {
  var locSelect = document.getElementById('edit_location_id');
  var subSelect = document.getElementById('edit_sub_location_id');
  var currentSub = '<%= asset.sub_location_id || '' %>';
  async function loadSubs() {
    subSelect.innerHTML = '<option value="">— None —</option>';
    if (!locSelect.value) return;
    try {
      var res = await fetch('<%= hams_url('/api/locations') %>/' + locSelect.value + '/sub-locations');
      var rows = await res.json();
      for (var r of rows) {
        var opt = document.createElement('option');
        opt.value = r.id;
        opt.textContent = r.name + (r.code ? ' (' + r.code + ')' : '');
        if (String(r.id) === currentSub) opt.selected = true;
        subSelect.appendChild(opt);
      }
    } catch (e) {}
  }
  locSelect.addEventListener('change', function() { currentSub = ''; loadSubs(); });
  loadSubs();
})();
</script>
</div>
