<div class="no-print flex items-center justify-between mb-8">
  <div class="flex items-center gap-3">
    <a href="<%= hams_url('/assets') %>" class="p-2 rounded-xl hover:bg-white/5 text-slate-400"><i data-lucide="arrow-left" class="w-5 h-5"></i></a>
    <h1 class="font-heading text-2xl font-bold text-white">Asset Labels</h1>
  </div>
  <button onclick="window.print()" class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium"><i data-lucide="printer" class="w-4 h-4"></i>Print Labels</button>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 print-grid">
  <% for (const a of assets) { %>
  <div class="bg-white text-slate-900 rounded-2xl p-5 flex gap-4 items-center label-card">
    <img src="<%= await qrDataUrl(hams_url('/labels/assets/' + a.label_token), 110) %>" width="110" height="110" alt="QR">
    <div class="min-w-0">
      <div class="font-mono text-sm font-bold"><%= a.asset_tag %></div>
      <div class="text-sm font-semibold truncate"><%= a.name %></div>
      <% if (a.serial_number) { %><div class="text-xs text-slate-500 font-mono">SN: <%= a.serial_number %></div><% } %>
      <div class="text-xs text-slate-500"><%= a.category_name || '' %><%= a.location_name ? ' · ' + a.location_name : '' %></div>
    </div>
  </div>
  <% } %>
  <% if (!assets.length) { %><p class="text-slate-500">No assets selected. Choose assets from the list first.</p><% } %>
</div>

<style>
@media print {
  aside, header, .no-print { display: none !important; }
  body, .bg-hams-bg { background: white !important; }
  .label-card { border: 1px solid #ccc; break-inside: avoid; }
}
</style>
