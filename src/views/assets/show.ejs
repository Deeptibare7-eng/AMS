<div x-data="{ checkoutOpen: false, checkinOpen: false }">
<div class="flex flex-wrap items-center justify-between gap-4 mb-8">
  <div class="flex items-center gap-3">
    <a href="<%= hams_url('/assets') %>" class="p-2 rounded-xl hover:bg-white/5 text-slate-400"><i data-lucide="arrow-left" class="w-5 h-5"></i></a>
    <div>
      <h1 class="font-heading text-2xl md:text-3xl font-bold text-white"><%= asset.name %></h1>
      <p class="text-sm text-slate-500 mt-1 font-mono"><%= asset.asset_tag %></p>
    </div>
  </div>
  <div class="flex items-center gap-2">
    <% const st = String(asset.status_label_name || asset.status || '').toLowerCase();
       const isAvailable = ['available', 'in stock', 'ready to deploy', 'ready'].includes(st);
       const isAssigned = !!asset.assigned_to; %>
    <% if (isAssigned) { %>
    <button @click="checkinOpen = true" class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium"><i data-lucide="log-in" class="w-4 h-4"></i>Check In</button>
    <% } else if (isAvailable) { %>
    <button @click="checkoutOpen = true" class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium"><i data-lucide="log-out" class="w-4 h-4"></i>Check Out</button>
    <% } else { %>
    <span class="px-4 py-2.5 rounded-xl bg-white/5 text-slate-500 text-sm">Not Available</span>
    <% } %>
    <a href="<%= hams_url('/assets/' + asset.id + '/edit') %>" class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-sm text-slate-300"><i data-lucide="edit-3" class="w-4 h-4"></i>Edit</a>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
  <div class="lg:col-span-2 space-y-6">
    <div class="bg-hams-card border border-white/5 rounded-3xl p-6">
      <h2 class="font-heading font-semibold text-white mb-5">Asset Profile</h2>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 text-sm">
        <% const profile = [
          ['Serial', asset.serial_number], ['Model', asset.model_name || asset.model_number],
          ['Category', asset.category_name || asset.category], ['Manufacturer', asset.manufacturer_name],
          ['Supplier', asset.supplier_name], ['Location', asset.location_name],
          ['Purchase Date', formatDate(asset.purchase_date)], ['Warranty Expiry', formatDate(asset.warranty_expiry)]
        ]; %>
        <% for (const [label, value] of profile) { %>
        <div>
          <dt class="text-xs text-slate-500 mb-0.5"><%= label %></dt>
          <dd class="text-white font-medium"><%= value || '—' %></dd>
        </div>
        <% } %>
      </dl>
      <% if (asset.notes) { %>
      <div class="mt-5 pt-5 border-t border-white/5">
        <div class="text-xs text-slate-500 mb-1">Notes</div>
        <p class="text-sm text-slate-300 whitespace-pre-line"><%= asset.notes %></p>
      </div>
      <% } %>
    </div>

    <% if (insight) { %>
    <% const GS = { 'Good': 'emerald', 'Acceptable': 'sky', 'Old / low spec': 'amber', 'Not deployable': 'rose' }; const gc = GS[insight.quality_grade] || 'slate'; %>
    <div class="bg-hams-card border border-white/5 rounded-3xl p-6">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
        <h2 class="font-heading font-semibold text-white">Quality &amp; Location</h2>
        <a href="<%= hams_url('/location-workspace' + (insight.current_site ? '?site=' + encodeURIComponent(insight.current_site) : '')) %>" class="text-xs text-blue-400 hover:text-blue-300">Location Workspace →</a>
      </div>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 text-sm">
        <div class="sm:col-span-2">
          <dt class="text-xs text-slate-500 mb-1">Quality grade</dt>
          <dd class="flex flex-wrap items-center gap-2">
            <% if (insight.quality_grade) { %>
            <span class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-<%= gc %>-500/10 text-<%= gc %>-400 border border-<%= gc %>-500/20"><%= insight.quality_grade %></span>
            <span class="text-slate-400 text-xs"><%= insight.quality_reason %></span>
            <% } else { %><span class="text-slate-500">Not graded (grades apply to laptops)</span><% } %>
          </dd>
        </div>
        <div><dt class="text-xs text-slate-500 mb-0.5">Current location</dt><dd class="text-white font-medium"><%= insight.current_site || '—' %></dd>
          <dd class="text-[11px] text-slate-500"><%= insight.state === 'In stock' && insight.stock_site ? 'from Machine Name (stock entry)' : 'site of the base location' %></dd></div>
        <div><dt class="text-xs text-slate-500 mb-0.5">Base location (Asset Location)</dt><dd class="text-white font-medium"><%= insight.base_location || '—' %></dd>
          <dd class="text-[11px] text-slate-500"><%= insight.base_site || '' %></dd></div>
        <div><dt class="text-xs text-slate-500 mb-0.5">State</dt><dd class="text-white font-medium"><%= insight.state %></dd></div>
        <div><dt class="text-xs text-slate-500 mb-0.5">Register status</dt><dd class="text-white font-medium"><%= (asset.custom_fields_data && typeof asset.custom_fields_data === 'object' && asset.custom_fields_data['Asset Status (source)']) || '—' %></dd></div>
      </dl>
    </div>
    <% } %>

    <% if (typeof aiOn !== 'undefined' && aiOn.has('data_quality')) { %><%- await include('../ai/_asset_insights') %><% } %>
    <% if (typeof aiOn !== 'undefined' && (aiOn.has('lifecycle') || aiOn.has('anomaly'))) { %><%- await include('../ai/_asset_risk') %><% } %>
    <% if (typeof aiOn !== 'undefined' && aiOn.has('agents') && await canNav('ai.view', 'ai')) { %><%- await include('../ai/_asset_agents') %><% } %>

    <div id="history" class="bg-hams-card border border-white/5 rounded-3xl p-6">
      <h2 class="font-heading font-semibold text-white mb-1">Complete History</h2>
      <p class="text-xs text-slate-500 mb-5">Purchase and warranty from the register, every allocation and return, stock movements and audit entries — oldest first.</p>
      <% const KIND = { purchase: ['shopping-cart', 'blue'], warranty: ['shield-check', 'violet'], allocated: ['log-out', 'emerald'], returned: ['log-in', 'amber'], ledger: ['package', 'slate'], audit: ['file-clock', 'slate'] }; %>
      <ol class="relative border-l border-white/10 ml-2 space-y-4">
        <% for (const ev of history) { const [icon, c] = KIND[ev.kind] || ['circle', 'slate']; %>
        <li class="ml-5">
          <span class="absolute -left-[9px] mt-1 w-4 h-4 rounded-full bg-<%= c %>-500/15 border border-<%= c %>-500/30 flex items-center justify-center"><i data-lucide="<%= icon %>" class="w-2.5 h-2.5 text-<%= c %>-400"></i></span>
          <div class="text-[11px] text-slate-500"><%= formatDate(ev.at) %></div>
          <div class="text-sm text-white"><%= ev.title %></div>
          <% if (ev.detail) { %><div class="text-xs text-slate-400"><%= ev.detail %></div><% } %>
        </li>
        <% } %>
        <% if (!history.length) { %><li class="ml-5 text-sm text-slate-500">No history recorded.</li><% } %>
      </ol>
    </div>

    <% let cfData = asset.custom_fields_data;
       if (typeof cfData === 'string') { try { cfData = JSON.parse(cfData); } catch (e) { cfData = {}; } }
       cfData = cfData || {};
       const cfEntries = Object.entries(cfData).filter(([k, v]) => v !== '' && v !== null); %>
    <% if (cfEntries.length) { %>
    <div class="bg-hams-card border border-white/5 rounded-3xl p-6">
      <h2 class="font-heading font-semibold text-white mb-5">Specifications &amp; Metadata</h2>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 text-sm">
        <% for (const [key, value] of cfEntries) { %>
        <div>
          <dt class="text-xs text-slate-500 mb-0.5"><%= key.replace(/_/g, ' ') %></dt>
          <dd class="text-white font-medium"><%= value %></dd>
        </div>
        <% } %>
      </dl>
    </div>
    <% } %>

    <div class="bg-hams-card border border-white/5 rounded-3xl overflow-hidden">
      <h2 class="font-heading font-semibold text-white px-6 pt-6 pb-4">Assignment History</h2>
      <div class="table-responsive">
        <table class="w-full min-w-[700px] text-sm">
          <thead><tr class="text-left text-xs text-slate-500 uppercase border-b border-white/5">
            <th class="px-6 py-3">User</th><th class="px-6 py-3">Checked Out</th><th class="px-6 py-3">Expected Return</th><th class="px-6 py-3">Returned</th><th class="px-6 py-3">Condition</th>
          </tr></thead>
          <tbody class="divide-y divide-white/5">
            <% for (const a of assignments) { %>
            <tr>
              <td class="px-6 py-3 text-white"><%= a.user_name || '—' %></td>
              <td class="px-6 py-3 text-slate-400"><%= formatDateTime(a.assigned_at) %></td>
              <td class="px-6 py-3 text-slate-400"><%= formatDate(a.expected_return_at) || '—' %></td>
              <td class="px-6 py-3 text-slate-400"><%= a.returned_at ? formatDateTime(a.returned_at) : 'Active' %></td>
              <td class="px-6 py-3 text-slate-400"><%= a.checkin_condition || a.checkout_condition || '—' %></td>
            </tr>
            <% } %>
            <% if (!assignments.length) { %><tr><td colspan="5" class="px-6 py-8 text-center text-slate-500">No assignment history.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-hams-card border border-white/5 rounded-3xl overflow-hidden">
      <h2 class="font-heading font-semibold text-white px-6 pt-6 pb-4">Asset Stock History</h2>
      <div class="table-responsive">
        <table class="w-full min-w-[800px] text-sm">
          <thead><tr class="text-left text-xs text-slate-500 uppercase border-b border-white/5">
            <th class="px-6 py-3">Movement</th><th class="px-6 py-3">Direction</th><th class="px-6 py-3">Holder / Vendor</th><th class="px-6 py-3">Location</th><th class="px-6 py-3">Reference</th><th class="px-6 py-3">Date</th>
          </tr></thead>
          <tbody class="divide-y divide-white/5">
            <% for (const m of stock_history) { %>
            <tr>
              <td class="px-6 py-3 text-white"><%= m.movement_type || '—' %></td>
              <td class="px-6 py-3"><span class="px-2 py-0.5 rounded text-xs <%= m.direction === 'in' ? 'bg-emerald-500/10 text-emerald-400' : 'bg-amber-500/10 text-amber-400' %>"><%= String(m.direction).toUpperCase() %></span></td>
              <td class="px-6 py-3 text-slate-400"><%= m.holder_name || m.vendor_name || '—' %></td>
              <td class="px-6 py-3 text-slate-400"><%= m.to_location_name || m.from_location_name || '—' %></td>
              <td class="px-6 py-3 text-slate-400"><%= m.reference || '—' %></td>
              <td class="px-6 py-3 text-slate-400"><%= formatDateTime(m.occurred_at || m.created_at) %></td>
            </tr>
            <% } %>
            <% if (!stock_history.length) { %><tr><td colspan="6" class="px-6 py-8 text-center text-slate-500">No stock movements recorded.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <aside class="space-y-6">
    <div class="bg-hams-card border border-white/5 rounded-3xl p-6">
      <h2 class="font-heading font-semibold text-white mb-5">Lifecycle</h2>
      <div class="space-y-4 text-sm">
        <div class="flex justify-between items-center">
          <span class="text-slate-500">Status</span>
          <span class="px-2.5 py-1 rounded-lg text-xs font-medium" style="background: <%= (asset.status_label_color || '#3b82f6') %>22; color: <%= asset.status_label_color || '#3b82f6' %>;"><%= asset.status_label_name || asset.status %></span>
        </div>
        <div class="flex justify-between"><span class="text-slate-500">Assigned To</span><span class="text-white"><%= asset.assigned_to_name || 'Unassigned' %></span></div>
        <div class="flex justify-between"><span class="text-slate-500">Purchase Cost</span><span class="text-white"><%= asset.purchase_cost ? Number(asset.purchase_cost).toFixed(2) : '—' %></span></div>
        <div class="flex justify-between"><span class="text-slate-500">Book Value</span><span class="text-white"><%= book_value !== null && book_value !== undefined ? Number(book_value).toFixed(2) : '—' %></span></div>
        <% if (asset.procurement_id) { %>
        <div class="flex justify-between"><span class="text-slate-500">Procurement</span><a href="<%= hams_url('/procurement/' + asset.procurement_id) %>" class="text-blue-400 hover:underline">Record #<%= asset.procurement_id %></a></div>
        <% } %>
      </div>
    </div>
    <div class="bg-white rounded-3xl p-6 text-center">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">Asset Label</div>
      <img src="<%= await qrDataUrl(hams_url('/labels/assets/' + asset.label_token), 160) %>" width="160" height="160" class="mx-auto mb-2" alt="QR">
      <div class="font-mono text-xs text-slate-700 mb-3"><%= asset.asset_tag %></div>
      <a href="<%= hams_url('/assets/labels') %>?ids[]=<%= asset.id %>" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 text-white text-xs font-medium"><i data-lucide="printer" class="w-3.5 h-3.5"></i>Print Label</a>
    </div>
  </aside>
</div>

<!-- Checkout modal -->
<div x-show="checkoutOpen" x-cloak class="fixed inset-0 z-[90] flex items-center justify-center px-4">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" @click="checkoutOpen = false"></div>
  <div class="relative bg-hams-card border border-white/10 rounded-3xl p-6 w-full max-w-md">
    <h3 class="font-heading font-semibold text-white mb-4">Check Out Asset</h3>
    <form method="POST" action="<%= hams_url('/assets/' + asset.id + '/checkout') %>" class="space-y-4">
      <%- csrf_field %>
      <div>
        <label class="block text-xs font-medium text-slate-400 mb-1.5">Assign To *</label>
        <%- await include('../components/picker', { name: 'user_id', source: 'users', required: true, placeholder: 'Type a name, email or CTID…' }) %>
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-400 mb-1.5">Expected Return</label>
        <input type="date" name="expected_return_at" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-400 mb-1.5">Condition</label>
        <select name="checkout_condition" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
          <option value="good">Good</option><option value="fair">Fair</option><option value="new">New</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-400 mb-1.5">Notes</label>
        <textarea name="checkout_notes" rows="2" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></textarea>
      </div>
      <div class="flex justify-end gap-2">
        <button type="button" @click="checkoutOpen = false" class="px-4 py-2 rounded-xl bg-white/5 text-sm text-slate-300">Cancel</button>
        <button type="submit" class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-sm text-white font-medium">Check Out</button>
      </div>
    </form>
  </div>
</div>

<!-- Checkin modal -->
<div x-show="checkinOpen" x-cloak class="fixed inset-0 z-[90] flex items-center justify-center px-4">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" @click="checkinOpen = false"></div>
  <div class="relative bg-hams-card border border-white/10 rounded-3xl p-6 w-full max-w-md">
    <h3 class="font-heading font-semibold text-white mb-4">Check In Asset</h3>
    <form method="POST" action="<%= hams_url('/assets/' + asset.id + '/checkin') %>" class="space-y-4">
      <%- csrf_field %>
      <div>
        <label class="block text-xs font-medium text-slate-400 mb-1.5">Condition</label>
        <select name="checkin_condition" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
          <option value="good">Good</option><option value="fair">Fair</option>
          <option value="repair">Needs Repair</option><option value="damaged">Damaged</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-400 mb-1.5">Notes</label>
        <textarea name="checkin_notes" rows="2" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></textarea>
      </div>
      <div class="flex justify-end gap-2">
        <button type="button" @click="checkinOpen = false" class="px-4 py-2 rounded-xl bg-white/5 text-sm text-slate-300">Cancel</button>
        <button type="submit" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-sm text-white font-medium">Check In</button>
      </div>
    </form>
  </div>
</div>
</div>
