<!DOCTYPE html>
<html lang="en" class="dark">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sign In | <%= brandName %></title>
<link rel="stylesheet" href="/css/app.css">
<link rel="stylesheet" href="/css/fonts.css">
<style>body{font-family:'Inter',sans-serif}</style>
</head>
<body class="bg-hams-bg text-slate-200 min-h-screen flex items-center justify-center px-4">
<div class="w-full max-w-md">
  <div class="bg-hams-card border border-white/5 rounded-3xl p-8 shadow-2xl">
    <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white font-bold text-xl mb-6" style="font-family:'Outfit'"><%= brandName.charAt(0) %></div>
    <h1 class="text-2xl font-semibold text-white mb-1" style="font-family:'Outfit'">Welcome back</h1>
    <p class="text-sm text-slate-500 mb-6">Sign in to <%= brandName %> Enterprise IT Operations</p>

    <% for (const [key, color] of [['success', 'emerald'], ['error', 'rose']]) { if (flash[key]) { %>
    <div class="mb-4 px-4 py-3 rounded-xl bg-<%= color %>-500/10 border border-<%= color %>-500/20 text-<%= color %>-300 text-sm"><%= flash[key] %></div>
    <% } } %>

    <form method="POST" action="<%= hams_url('/login') %>" class="space-y-4">
      <%- csrf_field %>
      <div>
        <label class="block text-xs font-medium text-slate-400 mb-1.5">Email</label>
        <input type="email" name="email" required placeholder="admin@hams.inc"
               class="w-full px-4 py-3 rounded-xl bg-hams-bg border border-white/10 text-sm outline-none focus:border-blue-500">
      </div>
      <div>
        <div class="flex justify-between mb-1.5">
          <label class="block text-xs font-medium text-slate-400">Password</label>
          <a href="<%= hams_url('/forgot-password') %>" class="text-xs text-blue-400 hover:underline">Forgot?</a>
        </div>
        <input type="password" name="password" required
               class="w-full px-4 py-3 rounded-xl bg-hams-bg border border-white/10 text-sm outline-none focus:border-blue-500">
      </div>
      <label class="flex items-center gap-2 text-xs text-slate-400">
        <input type="checkbox" id="remember" class="rounded"> Remember this device
      </label>
      <button type="submit" class="w-full py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold">Sign In</button>
    </form>

    <% if (providers && (providers.oidc || providers.saml)) { %>
    <div class="flex items-center gap-3 my-5"><div class="flex-1 h-px bg-white/5"></div><span class="text-[10px] text-slate-600 uppercase">SSO</span><div class="flex-1 h-px bg-white/5"></div></div>
    <div class="space-y-2">
      <% if (providers.oidc) { %><a href="<%= hams_url('/auth/oidc') %>" class="block w-full py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-center text-sm">Sign in with OIDC</a><% } %>
      <% if (providers.saml) { %><a href="<%= hams_url('/auth/saml') %>" class="block w-full py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-center text-sm">Sign in with SAML</a><% } %>
    </div>
    <% } %>
  </div>
  <p class="text-center text-xs text-slate-600 mt-6">Need access? Contact System Admin</p>
</div>
</body>
</html>
