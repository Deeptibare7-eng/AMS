<!DOCTYPE html>
<html lang="en" class="dark">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Two-Factor Authentication | <%= brandName %></title>
<link rel="stylesheet" href="/css/app.css">
<link rel="stylesheet" href="/css/fonts.css">
<style>body{font-family:'Inter',sans-serif}</style>
</head>
<body class="bg-hams-bg text-slate-200 min-h-screen flex items-center justify-center px-4">
<div class="w-full max-w-sm bg-hams-card border border-white/5 rounded-3xl p-8 text-center">
  <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-blue-500/15 text-blue-400 flex items-center justify-center text-2xl">&#128274;</div>
  <h1 class="text-xl font-semibold text-white mb-1" style="font-family:'Outfit'">Two-Factor Authentication</h1>
  <p class="text-sm text-slate-500 mb-6">Enter the 6-digit code from your authenticator app.</p>
  <% for (const [key, color] of [['success', 'emerald'], ['error', 'rose']]) { if (flash[key]) { %>
  <div class="mb-4 px-4 py-3 rounded-xl bg-<%= color %>-500/10 border border-<%= color %>-500/20 text-<%= color %>-300 text-sm"><%= flash[key] %></div>
  <% } } %>
  <form method="POST" action="<%= hams_url('/login/mfa') %>" class="space-y-4">
    <%- csrf_field %>
    <input type="text" name="code" maxlength="6" autofocus autocomplete="one-time-code"
           class="w-full px-4 py-4 rounded-xl bg-hams-bg border border-white/10 text-center text-2xl tracking-[0.5em] font-mono outline-none focus:border-blue-500">
    <button type="submit" class="w-full py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold">Verify &amp; Access &rarr;</button>
  </form>
  <a href="<%= hams_url('/logout') %>" class="inline-block mt-4 text-xs text-slate-500 hover:text-slate-300">Back to Login</a>
</div>
</body>
</html>
