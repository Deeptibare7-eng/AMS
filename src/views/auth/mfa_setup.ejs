<!DOCTYPE html>
<html lang="en" class="dark">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Security Setup | <%= brandName %></title>
<link rel="stylesheet" href="/css/app.css">
<link rel="stylesheet" href="/css/fonts.css">
<style>body{font-family:'Inter',sans-serif;background:#020617}</style>
</head>
<body class="text-slate-200 min-h-screen flex items-center justify-center px-4">
<div class="w-full max-w-sm bg-[#0f172a] border border-white/5 rounded-3xl p-8 text-center">
  <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-emerald-500/15 text-emerald-400 flex items-center justify-center text-2xl">&#128737;</div>
  <h1 class="text-xl font-semibold text-white mb-1" style="font-family:'Outfit'">Security Required</h1>
  <p class="text-sm text-slate-500 mb-6">Scan this QR code with your authenticator app, then enter the 6-digit code.</p>
  <% for (const [key, color] of [['success', 'emerald'], ['error', 'rose']]) { if (flash[key]) { %>
  <div class="mb-4 px-4 py-3 rounded-xl bg-<%= color %>-500/10 border border-<%= color %>-500/20 text-<%= color %>-300 text-sm"><%= flash[key] %></div>
  <% } } %>
  <div class="bg-white p-3 rounded-2xl inline-block mb-4"><img src="<%= qrCodeUrl %>" alt="QR code" width="200" height="200"></div>
  <div class="text-xs text-slate-500 mb-1">Manual entry key</div>
  <div class="font-mono text-sm text-white bg-white/5 rounded-lg px-3 py-2 mb-6 select-all"><%= secret %></div>
  <form method="POST" action="<%= hams_url('/login/mfa/setup') %>" class="space-y-4">
    <%- csrf_field %>
    <input type="hidden" name="secret" value="<%= secret %>">
    <input type="text" name="code" maxlength="6" autofocus
           class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/10 text-center text-xl tracking-[0.4em] font-mono outline-none focus:border-emerald-500">
    <button type="submit" class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold">Verify &amp; Continue</button>
  </form>
  <a href="<%= hams_url('/logout') %>" class="inline-block mt-4 text-xs text-slate-500 hover:text-slate-300">Cancel &amp; Sign Out</a>
</div>
</body>
</html>
