<%
// Multi-select filter for GET forms: tick several values; submits name[]=value for each.
// Locals: name, label, options [{ value, label }], selected [values], search (bool, default when > 8 options)
const _sel = (typeof selected !== 'undefined' && selected ? selected : []).map(String);
const _opts = options || [];
const _search = typeof search !== 'undefined' ? search : _opts.length > 8;
const _picked = _opts.filter(o => _sel.includes(String(o.value)));
const _text = !_picked.length ? `All ${label.toLowerCase()}`
  : _picked.length === _opts.length ? `All ${label.toLowerCase()} (selected)`
  : _picked.length === 1 ? _picked[0].label : `${label}: ${_picked.length} selected`;
%>
<div class="relative" x-data="{ open: false, q: '', n: <%= _picked.length %>, text: <%= JSON.stringify(_text) %> }" @click.outside="open = false" @keydown.escape="open = false">
  <button type="button" @click="open = !open"
          class="w-full flex items-center justify-between gap-2 px-4 py-2.5 rounded-xl bg-hams-bg border text-sm text-left"
          :class="n ? 'border-blue-500/40 text-white' : 'border-white/10 text-slate-300'">
    <span class="truncate" x-text="text"><%= _text %></span>
    <i data-lucide="chevron-down" class="w-4 h-4 shrink-0 text-slate-500"></i>
  </button>
  <div x-show="open" x-cloak class="absolute z-50 mt-1 w-full min-w-[240px] bg-hams-card border border-white/10 rounded-xl shadow-2xl p-2">
    <div class="flex items-center justify-between gap-3 px-2 pb-2 text-[11px] text-slate-500">
      <span class="truncate"><%= label %></span>
      <span class="flex items-center gap-3 shrink-0">
        <!-- Select all ticks every option (only the ones matching the search box when it is used). -->
        <button type="button" class="text-blue-400 hover:text-blue-300"
                @click="$root.querySelectorAll('label.ms-opt').forEach(l => { if (l.style.display !== 'none') l.querySelector('input').checked = true; }); $refs.list.dispatchEvent(new Event('change', { bubbles: true }))">Select all</button>
        <button type="button" class="text-slate-400 hover:text-white"
                @click="$root.querySelectorAll('input[type=checkbox]').forEach(c => c.checked = false); $refs.list.dispatchEvent(new Event('change', { bubbles: true }))">Clear</button>
      </span>
    </div>
    <% if (_search) { %>
    <input type="text" x-model="q" placeholder="Search <%= label.toLowerCase() %>..." class="w-full mb-2 px-3 py-2 rounded-lg bg-hams-bg border border-white/10 text-xs">
    <% } %>
    <div class="max-h-64 overflow-y-auto space-y-0.5" x-ref="list"
         @change="const c = [...$root.querySelectorAll('input[type=checkbox]:checked')]; n = c.length;
                  text = !n ? <%= JSON.stringify(`All ${label.toLowerCase()}`) %> : n === <%= _opts.length %> ? <%= JSON.stringify(`All ${label.toLowerCase()} (selected)`) %> : n === 1 ? c[0].dataset.l : <%= JSON.stringify(label + ': ') %> + n + ' selected'">
      <% for (const o of _opts) { %><label class="ms-opt" x-show="!q || $el.textContent.toLowerCase().includes(q.toLowerCase())"><input type="checkbox" name="<%= name %>[]" value="<%= o.value %>" data-l="<%= o.label %>" class="rounded"<%= _sel.includes(String(o.value)) ? ' checked' : '' %>><span class="truncate"><%= o.label %></span></label><% } %>
      <% if (!_opts.length) { %><div class="px-2 py-2 text-xs text-slate-500">No values</div><% } %>
    </div>
  </div>
</div>
