<div x-data="{ filters: [{ column: '', operator: '=', value: '' }] }">
<div class="mb-8">
  <h1 class="font-heading text-2xl md:text-3xl font-bold text-white">Export Builder</h1>
  <p class="text-sm text-slate-500 mt-1">Column-level CSV export</p>
</div>

<div class="flex flex-wrap gap-2 mb-6">
  <% for (const t of tables) { %>
  <a href="<%= hams_url('/data-transfer/export') %>?table=<%= t %>"
     class="px-4 py-2 rounded-xl text-sm font-mono <%= t === currentTable ? 'bg-blue-600 text-white' : 'bg-white/5 text-slate-400 hover:text-white' %>"><%= t %></a>
  <% } %>
</div>

<form method="POST" action="<%= hams_url('/data-transfer/export/process') %>" class="bg-hams-card border border-white/5 rounded-3xl p-6 max-w-3xl">
  <%- csrf_field %>
  <input type="hidden" name="table" value="<%= currentTable %>">
  <h2 class="font-heading font-semibold text-white mb-4">Columns</h2>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2 mb-6 max-h-56 overflow-y-auto">
    <% for (const col of columns) { %>
    <label class="flex items-center gap-2 px-3 py-2 rounded-xl bg-white/[.02] text-xs text-slate-300 font-mono">
      <input type="checkbox" name="columns[]" value="<%= col %>" checked class="rounded"><%= col %>
    </label>
    <% } %>
  </div>

  <h2 class="font-heading font-semibold text-white mb-4">Filters</h2>
  <template x-for="(f, i) in filters" :key="i">
    <div class="flex gap-2 mb-2">
      <select :name="'filters[column][]'" x-model="f.column" class="flex-1 px-3 py-2 rounded-xl bg-hams-bg border border-white/10 text-sm font-mono">
        <option value="">— column —</option>
        <% for (const col of columns) { %><option value="<%= col %>"><%= col %></option><% } %>
      </select>
      <select :name="'filters[operator][]'" x-model="f.operator" class="w-24 px-3 py-2 rounded-xl bg-hams-bg border border-white/10 text-sm">
        <option value="=">=</option><option value="LIKE">LIKE</option>
      </select>
      <input type="text" :name="'filters[value][]'" x-model="f.value" placeholder="value" class="flex-1 px-3 py-2 rounded-xl bg-hams-bg border border-white/10 text-sm">
      <button type="button" @click="filters.splice(i, 1)" class="p-2 rounded-lg text-rose-400 hover:bg-rose-500/10"><i data-lucide="x" class="w-4 h-4"></i></button>
    </div>
  </template>
  <button type="button" @click="filters.push({ column: '', operator: '=', value: '' })" class="text-xs text-blue-400 hover:underline mb-6">+ Add filter</button>

  <div><button type="submit" class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium"><i data-lucide="download" class="w-4 h-4"></i>Export CSV</button></div>
</form>
</div>
