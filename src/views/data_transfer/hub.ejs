<div class="mb-8">
  <h1 class="font-heading text-2xl md:text-3xl font-bold text-white">Advanced Data Transfer</h1>
  <p class="text-sm text-slate-500 mt-1">Column-level export builder and raw CSV import mapper</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl">
  <a href="<%= hams_url('/data-transfer/export') %>" class="bg-hams-card border border-white/5 rounded-3xl p-8 hover:border-blue-500/30 group">
    <span class="w-12 h-12 rounded-2xl bg-blue-500/10 text-blue-400 flex items-center justify-center mb-4 group-hover:bg-blue-500/20"><i data-lucide="file-down" class="w-6 h-6"></i></span>
    <h2 class="font-heading font-semibold text-white mb-2">Export Builder</h2>
    <p class="text-sm text-slate-500">Select tables, columns, and filters to export raw data as CSV.</p>
  </a>
  <a href="<%= hams_url('/data-transfer/import') %>" class="bg-hams-card border border-white/5 rounded-3xl p-8 hover:border-emerald-500/30 group">
    <span class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-4 group-hover:bg-emerald-500/20"><i data-lucide="file-up" class="w-6 h-6"></i></span>
    <h2 class="font-heading font-semibold text-white mb-2">Import Mapper</h2>
    <p class="text-sm text-slate-500">Upload a CSV and map its columns onto database fields.</p>
  </a>
</div>

<div class="mt-8">
  <div class="text-xs text-slate-500 uppercase tracking-wider mb-2">Available Tables</div>
  <div class="flex flex-wrap gap-2">
    <% for (const t of tables) { %><span class="px-3 py-1.5 rounded-xl bg-white/5 text-xs text-slate-400 font-mono"><%= t %></span><% } %>
  </div>
</div>
