<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-heading font-semibold text-white mb-1">
        <%= asset.name || `Asset #${assetId}` %>
      </h1>
      <p class="text-slate-400">Heartbeat monitoring and configuration</p>
    </div>
    <a href="<%= hamsUrl('/assets/' + assetId) %>" class="px-4 py-2 bg-white/5 hover:bg-white/10 rounded-lg text-sm text-slate-300">
      ← Back to Dashboard
    </a>
  </div>

  <!-- Current Status Card -->
  <% if (status) { %>
  <div class="bg-white/5 border border-white/5 rounded-2xl p-6">
    <div class="flex items-start justify-between mb-6">
      <div>
        <p class="text-xs text-slate-400 uppercase tracking-wider mb-2">Current Status</p>
        <div class="flex items-center gap-3">
          <span class="w-3 h-3 rounded-full <%= status.status === 'UP' ? 'bg-emerald-500' : status.status === 'DOWN' ? 'bg-rose-500' : 'bg-slate-500' %> animate-pulse"></span>
          <span class="text-2xl font-heading font-semibold text-white"><%= status.status %></span>
        </div>
      </div>
      <div class="text-right">
        <p class="text-xs text-slate-400 uppercase tracking-wider mb-2">Latency</p>
        <p class="text-2xl font-heading font-semibold text-white">
          <%= status.latency_ms !== null ? status.latency_ms + 'ms' : 'N/A' %>
        </p>
      </div>
    </div>
    <% if (status.error) { %>
    <div class="bg-rose-500/10 border border-rose-500/20 rounded-lg p-3 text-sm">
      <p class="text-rose-300"><strong>Error:</strong> <%= status.error %></p>
    </div>
    <% } else { %>
    <p class="text-sm text-emerald-300">✓ Asset is responding normally</p>
    <% } %>
    <p class="text-xs text-slate-400 mt-4">
      Last checked: <% if (status.last_checked_at) { %><span title="<%= new Date(status.last_checked_at).toISOString() %>"><%= new Date(status.last_checked_at).toLocaleString() %></span><% } else { %><span>Never</span><% } %>
    </p>
  </div>
  <% } %>

  <!-- Configuration Form -->
  <div class="bg-white/5 border border-white/5 rounded-2xl p-6">
    <h2 class="text-lg font-semibold text-white mb-4">Configure Monitoring</h2>
    <form method="POST" action="<%= hamsUrl(`/heartbeat/${assetId}/configure`) %>" class="space-y-4">
      <%- csrf_field %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-2">Hostname</label>
          <input type="text" name="hostname"
                 value="<%= monitor?.hostname || '' %>"
                 placeholder="e.g., server.example.com"
                 class="w-full px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-slate-300 text-sm placeholder-slate-500">
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-2">IP Address</label>
          <input type="text" name="ip_address"
                 value="<%= monitor?.ip_address || '' %>"
                 placeholder="e.g., 192.168.1.100"
                 class="w-full px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-slate-300 text-sm placeholder-slate-500">
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-2">Check Method</label>
          <select name="check_method" class="w-full px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-slate-300 text-sm">
            <option value="">-- Select --</option>
            <option value="icmp" <%= monitor?.check_method === 'icmp' ? 'selected' : '' %>>ICMP Ping</option>
            <option value="tcp" <%= monitor?.check_method === 'tcp' ? 'selected' : '' %>>TCP Port</option>
            <option value="http" <%= monitor?.check_method === 'http' ? 'selected' : '' %>>HTTP Endpoint</option>
            <option value="agent" <%= monitor?.check_method === 'agent' ? 'selected' : '' %>>Endpoint Agent (push)</option>
          </select>
        </div>
        <div x-data="{ method: '<%= monitor?.check_method || '' %>' }">
          <label class="block text-sm font-medium text-slate-300 mb-2">Port (for TCP)</label>
          <input type="number" name="port"
                 value="<%= monitor?.port || '' %>"
                 placeholder="e.g., 22"
                 class="w-full px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-slate-300 text-sm placeholder-slate-500">
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-300 mb-2">Health Check URL (for HTTP)</label>
        <input type="text" name="health_url"
               value="<%= monitor?.health_url || '' %>"
               placeholder="e.g., http://192.168.1.100:8080/health"
               class="w-full px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-slate-300 text-sm placeholder-slate-500">
      </div>

      <div class="flex items-center gap-3 py-2">
        <input type="checkbox" id="monitoring_enabled" name="monitoring_enabled"
               <%= monitor?.monitoring_enabled ? 'checked' : '' %>
               class="w-4 h-4 rounded bg-white/5 border border-white/10 cursor-pointer">
        <label for="monitoring_enabled" class="text-sm text-slate-300 cursor-pointer">Enable monitoring for this asset</label>
      </div>

      <div class="flex gap-3 pt-4 border-t border-white/5">
        <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium rounded-lg">
          Save Configuration
        </button>
        <a href="<%= hamsUrl('/assets/' + assetId) %>" class="px-6 py-2.5 bg-white/5 hover:bg-white/10 text-slate-300 text-sm font-medium rounded-lg">
          Cancel
        </a>
      </div>
    </form>
  </div>

  <!-- Heartbeat History -->
  <% if (history && history.length > 0) { %>
  <div class="bg-white/5 border border-white/5 rounded-2xl p-6">
    <h2 class="text-lg font-semibold text-white mb-4">Recent Checks (last <%= history.length %>)</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-white/10">
          <tr class="text-slate-400 text-xs uppercase tracking-wider">
            <th class="text-left py-3 px-4 font-medium">Timestamp</th>
            <th class="text-left py-3 px-4 font-medium">Status</th>
            <th class="text-left py-3 px-4 font-medium">Latency</th>
            <th class="text-left py-3 px-4 font-medium">Details</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          <% history.forEach(record => {
            const isUp = record.status === 'UP';
          %>
          <tr class="hover:bg-white/5 transition">
            <td class="py-3 px-4 text-slate-300">
              <span title="<%= new Date(record.checked_at).toISOString() %>">
                <%= new Date(record.checked_at).toLocaleString() %>
              </span>
            </td>
            <td class="py-3 px-4">
              <span class="inline-block px-2.5 py-1 rounded-lg text-xs font-semibold <%= isUp ? 'bg-emerald-500/20 text-emerald-300' : 'bg-rose-500/20 text-rose-300' %>">
                <%= record.status %>
              </span>
            </td>
            <td class="py-3 px-4 text-slate-300">
              <%= record.latency_ms !== null ? record.latency_ms + 'ms' : '—' %>
            </td>
            <td class="py-3 px-4 text-slate-400 max-w-xs truncate" title="<%= record.error || 'OK' %>">
              <%= record.error ? record.error.substring(0, 50) + (record.error.length > 50 ? '…' : '') : '✓ OK' %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
  <% } else { %>
  <div class="bg-white/5 border border-white/10 rounded-2xl p-8 text-center">
    <i data-lucide="info" class="w-8 h-8 text-slate-500 mx-auto mb-3 opacity-50"></i>
    <p class="text-slate-400">No check history yet. Configure the asset and enable monitoring to start tracking its health.</p>
  </div>
  <% } %>
</div>
