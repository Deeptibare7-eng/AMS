<div class="flex flex-wrap items-center justify-between gap-4 mb-8">
  <div>
    <h1 class="font-heading text-2xl md:text-3xl font-bold text-white">Log Viewer</h1>
    <p class="text-sm text-slate-500 mt-1"><%= total %> entries · <a href="<%= hams_url('/logs/retention') %>" class="text-blue-400 hover:underline">retention settings</a></p>
  </div>
  <form method="POST" action="<%= hams_url('/logs/clear') %>" data-confirm="Clear all log files?">
    <%- csrf_field %>
    <button class="px-5 py-2.5 rounded-xl bg-rose-600/15 text-rose-400 hover:bg-rose-600/25 text-sm">Clear Logs</button>
  </form>
</div>

<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
  <% for (const [level, color] of [['ERROR', 'rose'], ['WARNING', 'amber'], ['INFO', 'blue'], ['DEBUG', 'slate']]) { %>
  <div class="bg-hams-card border border-white/5 rounded-2xl p-4">
    <div class="text-xs text-slate-500 mb-1"><%= level %></div>
    <div class="text-xl font-bold text-<%= color %>-400 font-heading"><%= stats.by_level[level] || 0 %></div>
  </div>
  <% } %>
</div>

<form method="GET" class="mb-4 flex flex-wrap gap-3">
  <input type="text" name="search" value="<%= filters.search %>" placeholder="Search entries..." class="flex-1 min-w-[200px] px-4 py-2.5 rounded-xl bg-hams-card border border-white/10 text-sm">
  <div class="w-full sm:w-52">
    <%- await include('../components/multiselect', { name: 'level', label: 'Levels', options: ['ERROR', 'WARNING', 'INFO', 'DEBUG'].map(l => ({ value: l, label: l })), selected: filters.level }) %>
  </div>
  <input type="date" name="date_from" value="<%= filters.date_from %>" class="px-3 py-2.5 rounded-xl bg-hams-card border border-white/10 text-sm">
  <input type="date" name="date_to" value="<%= filters.date_to %>" class="px-3 py-2.5 rounded-xl bg-hams-card border border-white/10 text-sm">
  <button class="px-5 py-2.5 rounded-xl bg-white/5 text-sm text-slate-300">Filter</button>
</form>

<div class="bg-hams-card border border-white/5 rounded-3xl overflow-hidden">
  <div class="table-responsive">
    <table class="w-full min-w-[900px] text-sm">
      <thead><tr class="text-left text-xs text-slate-500 uppercase border-b border-white/5">
        <th class="px-6 py-4">Level</th><th class="px-6 py-4">Message</th><th class="px-6 py-4">Context</th><th class="px-6 py-4">Timestamp</th>
      </tr></thead>
      <tbody class="divide-y divide-white/5">
        <% const levelColors = { error: 'rose', warning: 'amber', info: 'blue', debug: 'slate' }; %>
        <% for (const entry of entries) { %>
        <tr class="hover:bg-white/[.02]">
          <% const lc = levelColors[entry.severity_class] || 'slate'; %>
          <td class="px-6 py-3"><span class="px-2 py-0.5 rounded text-xs bg-<%= lc %>-500/10 text-<%= lc %>-400"><%= entry.level %></span></td>
          <td class="px-6 py-3 text-slate-300 max-w-lg truncate"><%= entry.message %></td>
          <td class="px-6 py-3 text-xs text-slate-500 max-w-[200px] truncate"><%= entry.context_summary.url || '' %></td>
          <td class="px-6 py-3 text-slate-500 text-xs"><%= entry.timestamp %></td>
        </tr>
        <% } %>
        <% if (!entries.length) { %><tr><td colspan="4" class="px-6 py-12 text-center text-slate-500">No log entries.</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <% if (totalPages > 1) { %>
  <div class="flex items-center justify-between px-6 py-4 border-t border-white/5 text-sm">
    <span class="text-slate-500">Page <%= page %> of <%= totalPages %></span>
    <div class="flex gap-1">
      <% const pageQs = p => '?' + appendFilters(new URLSearchParams({ page: p }), { level: filters.level, search: filters.search, date_from: filters.date_from, date_to: filters.date_to, user_id: filters.user_id }).toString(); %>
      <% if (page > 1) { %><a href="<%= pageQs(page - 1) %>" class="px-3 py-1.5 rounded-lg bg-white/5 text-slate-300">Prev</a><% } %>
      <% if (page < totalPages) { %><a href="<%= pageQs(page + 1) %>" class="px-3 py-1.5 rounded-lg bg-white/5 text-slate-300">Next</a><% } %>
    </div>
  </div>
  <% } %>
</div>
