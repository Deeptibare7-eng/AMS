<div class="max-w-2xl">
<div class="flex items-center gap-3 mb-8">
  <a href="<%= hams_url('/logs') %>" class="p-2 rounded-xl hover:bg-white/5 text-slate-400"><i data-lucide="arrow-left" class="w-5 h-5"></i></a>
  <h1 class="font-heading text-2xl font-bold text-white">Log Retention</h1>
</div>

<form method="POST" action="<%= hams_url('/logs/retention') %>" class="bg-hams-card border border-white/5 rounded-3xl p-6 space-y-4 mb-6">
  <%- csrf_field %>
  <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Retention Days (1–365)</label>
    <input type="number" name="retention_days" min="1" max="365" value="<%= retention.retention_days %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></div>
  <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Max File Size (MB, 1–500)</label>
    <input type="number" name="max_file_size_mb" min="1" max="500" value="<%= retention.max_file_size_mb %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></div>
  <button type="submit" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium">Save Retention Settings</button>
</form>

<div class="bg-hams-card border border-white/5 rounded-3xl overflow-hidden">
  <h2 class="font-heading font-semibold text-white px-6 pt-6 pb-4">Log Files</h2>
  <table class="w-full text-sm">
    <thead><tr class="text-left text-xs text-slate-500 uppercase border-b border-white/5">
      <th class="px-6 py-3">File</th><th class="px-6 py-3">Size</th><th class="px-6 py-3">Lines</th><th class="px-6 py-3">Modified</th>
    </tr></thead>
    <tbody class="divide-y divide-white/5">
      <% for (const f of logFiles) { %>
      <tr><td class="px-6 py-3 text-white font-mono text-xs"><%= f.name %></td><td class="px-6 py-3 text-slate-400"><%= f.size_human %></td>
          <td class="px-6 py-3 text-slate-400"><%= f.lines %></td><td class="px-6 py-3 text-slate-500"><%= f.modified %></td></tr>
      <% } %>
      <% if (!logFiles.length) { %><tr><td colspan="4" class="px-6 py-8 text-center text-slate-500">No log files.</td></tr><% } %>
    </tbody>
  </table>
</div>
</div>
