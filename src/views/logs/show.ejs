<div class="max-w-3xl">
<div class="flex items-center gap-3 mb-8">
  <a href="<%= hams_url('/logs') %>" class="p-2 rounded-xl hover:bg-white/5 text-slate-400"><i data-lucide="arrow-left" class="w-5 h-5"></i></a>
  <h1 class="font-heading text-2xl font-bold text-white">Log Entry — <%= file %>:<%= entry.line_number %></h1>
</div>
<div class="bg-hams-card border border-white/5 rounded-3xl p-6 space-y-4">
  <div class="flex items-center gap-3">
    <span class="px-3 py-1 rounded-lg bg-rose-500/10 text-rose-400 text-xs font-semibold"><%= entry.level %></span>
    <span class="text-sm text-slate-500"><%= entry.timestamp %></span>
  </div>
  <p class="text-sm text-white"><%= entry.message %></p>
  <div>
    <div class="text-xs text-slate-500 uppercase mb-2">Context</div>
    <pre class="bg-black/40 rounded-xl p-4 text-xs text-slate-400 overflow-x-auto"><%= JSON.stringify(entry.context, null, 2) %></pre>
  </div>
</div>
</div>
