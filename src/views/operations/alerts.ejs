<div class="mb-8">
  <h1 class="font-heading text-2xl md:text-3xl font-bold text-white">Operational Alerts</h1>
  <p class="text-sm text-slate-500 mt-1">Warranty, license, and stock threshold alerts (90-day window)</p>
</div>

<% if (typeof aiOn !== 'undefined' && aiOn.has('anomaly') && await canNav('assets.view', 'assets')) { %><%- await include('../ai/_alerts_anomalies') %><% } %>
<% if (typeof aiOn !== 'undefined' && aiOn.has('compliance') && await canNav('licenses.view', 'licenses')) { %><%- await include('../ai/_alerts_compliance') %><% } %>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="bg-hams-card border border-white/5 rounded-3xl p-6">
    <h2 class="font-heading font-semibold text-white mb-4 flex items-center gap-2"><i data-lucide="shield-alert" class="w-4 h-4 text-rose-400"></i>Warranties Expiring</h2>
    <div class="space-y-2">
      <% for (const w of sections.warranties) { %>
      <a href="<%= hams_url('/assets/' + w.id) %>" class="flex items-center justify-between p-3 rounded-xl bg-white/[.02] hover:bg-white/5">
        <div><div class="text-sm text-white"><%= w.name %></div><div class="text-xs font-mono text-slate-500"><%= w.asset_tag %></div></div>
        <span class="text-xs text-rose-400"><%= formatDate(w.warranty_expiry) %></span>
      </a>
      <% } %>
      <% if (!sections.warranties.length) { %><p class="text-sm text-slate-500 py-4">No warranties expiring in the next 90 days.</p><% } %>
    </div>
  </div>

  <div class="bg-hams-card border border-white/5 rounded-3xl p-6">
    <h2 class="font-heading font-semibold text-white mb-4 flex items-center gap-2"><i data-lucide="key-round" class="w-4 h-4 text-amber-400"></i>Licenses Expiring</h2>
    <div class="space-y-2">
      <% for (const l of sections.licenses) { %>
      <div class="flex items-center justify-between p-3 rounded-xl bg-white/[.02]">
        <div class="text-sm text-white"><%= l.name %></div>
        <span class="text-xs text-amber-400"><%= formatDate(l.expiration_date) %></span>
      </div>
      <% } %>
      <% if (!sections.licenses.length) { %><p class="text-sm text-slate-500 py-4">No licenses expiring in the next 90 days.</p><% } %>
    </div>
  </div>

  <% const lowStockSections = [
    ['Accessories — Low Stock', sections.accessories, '/inventory/accessories', 'mouse'],
    ['Consumables — Low Stock', sections.consumables, '/inventory/consumables', 'package-minus'],
    ['Components — Low Stock', sections.components, '/inventory/components', 'cpu']
  ]; %>
  <% for (const [title, items, href, icon] of lowStockSections) { %>
  <div class="bg-hams-card border border-white/5 rounded-3xl p-6">
    <h2 class="font-heading font-semibold text-white mb-4 flex items-center gap-2"><i data-lucide="<%= icon %>" class="w-4 h-4 text-orange-400"></i><%= title %></h2>
    <div class="space-y-2">
      <% for (const item of items) { %>
      <a href="<%= hams_url(href) %>" class="flex items-center justify-between p-3 rounded-xl bg-white/[.02] hover:bg-white/5">
        <div class="text-sm text-white"><%= item.name %></div>
        <span class="text-xs"><span class="text-rose-400 font-medium"><%= item.available_qty %></span><span class="text-slate-500"> / min <%= item.min_qty %></span></span>
      </a>
      <% } %>
      <% if (!items.length) { %><p class="text-sm text-slate-500 py-4">All stock levels are healthy.</p><% } %>
    </div>
  </div>
  <% } %>
</div>
