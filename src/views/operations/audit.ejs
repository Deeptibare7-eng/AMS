<div class="mb-8">
  <h1 class="font-heading text-2xl md:text-3xl font-bold text-white">Audit Trails</h1>
  <p class="text-sm text-slate-500 mt-1">Latest 100 activity log entries</p>
</div>

<div class="bg-hams-card border border-white/5 rounded-3xl overflow-hidden">
  <div class="table-responsive">
    <table class="w-full min-w-[800px] text-sm">
      <thead><tr class="text-left text-xs text-slate-500 uppercase border-b border-white/5">
        <th class="px-6 py-4">Action</th><th class="px-6 py-4">User</th><th class="px-6 py-4">Description</th><th class="px-6 py-4">Time</th>
      </tr></thead>
      <tbody class="divide-y divide-white/5">
        <% for (const log of logs) { %>
        <tr class="hover:bg-white/[.02]">
          <td class="px-6 py-3"><span class="px-2.5 py-1 rounded-lg bg-blue-500/10 text-blue-400 text-xs font-mono"><%= log.action %></span></td>
          <td class="px-6 py-3 text-white"><%= log.user_name || 'System' %></td>
          <td class="px-6 py-3 text-slate-400"><%= log.description %></td>
          <td class="px-6 py-3 text-slate-500"><%= formatDateTime(log.created_at) %></td>
        </tr>
        <% } %>
        <% if (!logs.length) { %><tr><td colspan="4" class="px-6 py-12 text-center text-slate-500">No audit entries yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
