<div class="mb-8">
  <h1 class="font-heading text-2xl md:text-3xl font-bold text-white">Advanced Export</h1>
  <p class="text-sm text-slate-500 mt-1">Module: <span class="text-blue-400"><%= config.label %></span></p>
</div>

<div class="flex flex-wrap gap-2 mb-6">
  <% for (const m of modules) { %>
  <a href="<%= hams_url('/export-center/' + m.key) %>"
     class="px-4 py-2 rounded-xl text-sm <%= m.key === module ? 'bg-blue-600 text-white' : 'bg-white/5 text-slate-400 hover:text-white' %>"><%= m.label %></a>
  <% } %>
</div>

<form method="GET" action="<%= hams_url('/export-center/' + module + '/download') %>" class="bg-hams-card border border-white/5 rounded-3xl p-6 max-w-3xl">
  <h2 class="font-heading font-semibold text-white mb-4">Filters</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
    <div><label class="block text-xs text-slate-400 mb-1">Search</label>
      <input type="text" name="search" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></div>
    <% if (['assets', 'accessories', 'consumables', 'components'].includes(module)) { %>
    <div><label class="block text-xs text-slate-400 mb-1">Category</label>
      <%- await include('../components/multiselect', { name: 'category_id', label: 'Categories', options: filters.categories.map(o => ({ value: o.id, label: o.name })), selected: [] }) %></div>
    <% } %>
    <% if (module === 'assets') { %>
    <div><label class="block text-xs text-slate-400 mb-1">Status</label>
      <%- await include('../components/multiselect', { name: 'status_label_id', label: 'Statuses', options: filters.status_labels.map(o => ({ value: o.id, label: o.name })), selected: [] }) %></div>
    <% } %>
    <% if (['assets', 'accessories', 'consumables', 'components', 'licenses', 'sub_locations'].includes(module)) { %>
    <div><label class="block text-xs text-slate-400 mb-1">Location</label>
      <%- await include('../components/multiselect', { name: 'location_id', label: 'Locations', options: filters.locations.map(o => ({ value: o.id, label: o.name })), selected: [] }) %></div>
    <% } %>
    <% if (['accessories', 'consumables', 'components', 'licenses'].includes(module)) { %>
    <div><label class="block text-xs text-slate-400 mb-1">Manufacturer</label>
      <%- await include('../components/multiselect', { name: 'manufacturer_id', label: 'Manufacturers', options: filters.manufacturers.map(o => ({ value: o.id, label: o.name })), selected: [] }) %></div>
    <% } %>
    <% if (module === 'users') { %>
    <div><label class="block text-xs text-slate-400 mb-1">Role</label>
      <%- await include('../components/multiselect', { name: 'role', label: 'Roles', options: filters.user_roles.map(r => ({ value: r, label: r })), selected: [] }) %></div>
    <div><label class="block text-xs text-slate-400 mb-1">Status</label>
      <%- await include('../components/multiselect', { name: 'status', label: 'Statuses', options: filters.user_statuses.map(s => ({ value: s, label: s })), selected: [] }) %></div>
    <% } %>
    <% if (['assets', 'licenses', 'audit_logs'].includes(module)) { %>
    <div><label class="block text-xs text-slate-400 mb-1">Date From</label>
      <input type="date" name="date_from" class="w-full px-3 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></div>
    <div><label class="block text-xs text-slate-400 mb-1">Date To</label>
      <input type="date" name="date_to" class="w-full px-3 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></div>
    <% } %>
    <% if (['accessories', 'consumables', 'components'].includes(module)) { %>
    <div class="flex items-end"><label class="flex items-center gap-2 text-sm text-slate-300"><input type="checkbox" name="low_stock" value="1" class="rounded">Low stock only</label></div>
    <% } %>
    <% if (module === 'licenses') { %>
    <div class="flex items-end"><label class="flex items-center gap-2 text-sm text-slate-300"><input type="checkbox" name="expired" value="1" class="rounded">Expired only</label></div>
    <% } %>
    <div><label class="block text-xs text-slate-400 mb-1">Format</label>
      <select name="format" class="w-full px-3 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"><option value="csv">CSV</option><option value="json">JSON</option></select></div>
  </div>
  <button class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium"><i data-lucide="download" class="w-4 h-4"></i>Download Export</button>
</form>
