<div class="mb-8">
  <h1 class="font-heading text-2xl md:text-3xl font-bold text-white">Import Preview</h1>
  <p class="text-sm text-slate-500 mt-1">Module: <span class="text-blue-400"><%= module %></span> · <%= total %> rows parsed</p>
</div>

<% if (typeof adapted !== 'undefined' && adapted) { %>
<div class="mb-6 px-5 py-4 rounded-2xl border bg-blue-500/10 border-blue-500/20 text-blue-300 text-sm">
  <span class="font-semibold">IT-ASMS export detected</span> — your file was automatically converted to the
  asset import format (names, statuses, dates, and specs mapped; hardware specs kept as custom fields).
  <% if (adaptedSkipped > 0) { %><%= adaptedSkipped %> malformed/continuation fragments were skipped.<% } %>
</div>
<% } %>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
  <div class="bg-hams-card border border-white/5 rounded-2xl p-5">
    <div class="text-xs text-slate-500 mb-1">Total Rows</div>
    <div class="text-2xl font-bold text-white font-heading"><%= total %></div>
  </div>
  <div class="bg-hams-card border border-emerald-500/20 rounded-2xl p-5">
    <div class="text-xs text-slate-500 mb-1">Valid</div>
    <div class="text-2xl font-bold text-emerald-400 font-heading"><%= validation.valid_count %></div>
  </div>
  <div class="bg-hams-card border border-rose-500/20 rounded-2xl p-5">
    <div class="text-xs text-slate-500 mb-1">Errors</div>
    <div class="text-2xl font-bold text-rose-400 font-heading"><%= validation.error_count %></div>
  </div>
</div>

<% if (validation.errors.length) { %>
<div class="bg-hams-card border border-white/5 rounded-3xl overflow-hidden mb-6">
  <h2 class="font-heading font-semibold text-white px-6 pt-6 pb-4">Row Issues</h2>
  <div class="table-responsive max-h-80 overflow-y-auto">
    <table class="w-full min-w-[700px] text-sm">
      <thead><tr class="text-left text-xs text-slate-500 uppercase border-b border-white/5">
        <th class="px-6 py-3">Line</th><th class="px-6 py-3">Issues</th><th class="px-6 py-3">Row Data</th>
      </tr></thead>
      <tbody class="divide-y divide-white/5">
        <% for (const err of validation.errors) { %>
        <tr>
          <td class="px-6 py-3 text-slate-400"><%= err.line %></td>
          <td class="px-6 py-3"><% for (const msg of err.errors) { %><div class="text-xs text-rose-400"><%= msg %></div><% } %></td>
          <td class="px-6 py-3 text-xs text-slate-500 font-mono max-w-md truncate"><%= JSON.stringify(err.data) %></td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<div class="flex gap-3">
  <a href="<%= hams_url('/import') %>" class="px-5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-sm text-slate-300">Back</a>
  <% if (validation.valid_count > 0) { %>
  <form method="POST" action="<%= hams_url('/import/execute') %>">
    <%- csrf_field %>
    <button class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium">Import <%= validation.valid_count %> Valid Rows</button>
  </form>
  <% } %>
</div>
