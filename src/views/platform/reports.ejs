<div class="flex flex-wrap items-center justify-between gap-4 mb-8">
  <div>
    <h1 class="font-heading text-2xl md:text-3xl font-bold text-white">Reports &amp; Analytics</h1>
    <p class="text-sm text-slate-500 mt-1">Operational reports, exports, and lifecycle analytics</p>
  </div>
  <div class="flex gap-2">
    <% for (const [type, label] of [['assets', 'Assets CSV'], ['users', 'Users CSV'], ['licenses', 'Licenses CSV'], ['audit_logs', 'Audit CSV']]) { %>
    <a href="<%= hams_url('/export/' + type) %>" class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-xs text-slate-300"><i data-lucide="download" class="w-3.5 h-3.5"></i><%= label %></a>
    <% } %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
  <div class="bg-hams-card border border-white/5 rounded-3xl p-6">
    <h2 class="font-heading font-semibold text-white mb-4">Assets by Status</h2>
    <div class="space-y-2">
      <% const maxStatus = Math.max(1, ...reports.assets_by_status.map(r => r.total)); %>
      <% for (const r of reports.assets_by_status) { %>
      <div class="flex items-center gap-3 text-sm">
        <span class="w-32 text-slate-400 truncate"><%= r.label %></span>
        <div class="flex-1 h-2 rounded-full bg-white/5"><div class="h-2 rounded-full bg-blue-500" style="width: <%= Math.round(r.total / maxStatus * 100) %>%"></div></div>
        <span class="w-8 text-right text-white font-medium"><%= r.total %></span>
      </div>
      <% } %>
    </div>
  </div>
  <div class="bg-hams-card border border-white/5 rounded-3xl p-6">
    <h2 class="font-heading font-semibold text-white mb-4">Assets by Location</h2>
    <div class="space-y-2">
      <% const maxLoc = Math.max(1, ...reports.assets_by_location.map(r => r.total)); %>
      <% for (const r of reports.assets_by_location) { %>
      <div class="flex items-center gap-3 text-sm">
        <span class="w-32 text-slate-400 truncate"><%= r.label %></span>
        <div class="flex-1 h-2 rounded-full bg-white/5"><div class="h-2 rounded-full bg-indigo-500" style="width: <%= Math.round(r.total / maxLoc * 100) %>%"></div></div>
        <span class="w-8 text-right text-white font-medium"><%= r.total %></span>
      </div>
      <% } %>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
  <% for (const m of modules) { %>
  <div class="bg-hams-card border border-white/5 rounded-3xl p-5">
    <div class="flex items-center justify-between mb-3">
      <span class="w-9 h-9 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center"><i data-lucide="<%= m.icon %>" class="w-4 h-4"></i></span>
      <span class="text-lg font-bold text-white font-heading"><%= m.count %></span>
    </div>
    <div class="text-sm font-medium text-white mb-2"><%= m.label %></div>
    <a href="<%= hams_url('/export-center/' + m.key) %>" class="text-xs text-blue-400 hover:underline">Advanced Export &rarr;</a>
  </div>
  <% } %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="bg-hams-card border border-white/5 rounded-3xl overflow-hidden">
    <h2 class="font-heading font-semibold text-white px-6 pt-6 pb-4">Recent Checkouts</h2>
    <table class="w-full text-sm">
      <tbody class="divide-y divide-white/5">
        <% for (const c of reports.checkouts.slice(0, 10)) { %>
        <tr><td class="px-6 py-2.5 text-white"><%= c.asset_name %> <span class="text-xs text-slate-500 font-mono"><%= c.asset_tag %></span></td>
            <td class="px-6 py-2.5 text-slate-400"><%= c.user_name %></td>
            <td class="px-6 py-2.5 text-slate-500 text-xs"><%= formatDate(c.assigned_at) %></td></tr>
        <% } %>
        <% if (!reports.checkouts.length) { %><tr><td class="px-6 py-8 text-center text-slate-500">No checkouts.</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <div class="bg-hams-card border border-white/5 rounded-3xl overflow-hidden">
    <h2 class="font-heading font-semibold text-white px-6 pt-6 pb-4">Asset Aging (oldest first)</h2>
    <table class="w-full text-sm">
      <tbody class="divide-y divide-white/5">
        <% for (const a of reports.aging.slice(0, 10)) { %>
        <tr><td class="px-6 py-2.5 text-white"><%= a.name %> <span class="text-xs text-slate-500 font-mono"><%= a.asset_tag %></span></td>
            <td class="px-6 py-2.5 text-slate-400"><%= a.age_months %> months</td>
            <td class="px-6 py-2.5 text-slate-500 text-xs"><%= formatDate(a.purchase_date) %></td></tr>
        <% } %>
        <% if (!reports.aging.length) { %><tr><td class="px-6 py-8 text-center text-slate-500">No dated assets.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
