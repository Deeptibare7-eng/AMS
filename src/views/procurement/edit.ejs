<div class="max-w-2xl">
<div class="flex items-center gap-3 mb-8">
  <a href="<%= hams_url('/procurement/' + record.id) %>" class="p-2 rounded-xl hover:bg-white/5 text-slate-400"><i data-lucide="arrow-left" class="w-5 h-5"></i></a>
  <h1 class="font-heading text-2xl md:text-3xl font-bold text-white">Edit Record</h1>
</div>
<form method="POST" action="<%= hams_url('/procurement/' + record.id + '/update') %>" enctype="multipart/form-data"
      class="bg-hams-card border border-white/5 rounded-3xl p-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
  <%- csrf_field %>
  <div><label class="block text-xs font-medium text-slate-400 mb-1.5">PO Number</label>
    <input type="text" name="po_number" value="<%= record.po_number || '' %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm font-mono"></div>
  <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Invoice Number</label>
    <input type="text" name="invoice_number" value="<%= record.invoice_number || '' %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm font-mono"></div>
  <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Vendor</label>
    <select name="vendor_id" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
      <option value="">— None —</option>
      <% for (const s of references.suppliers) { %><option value="<%= s.id %>" <%= String(record.vendor_id) === String(s.id) ? 'selected' : '' %>><%= s.name %></option><% } %>
    </select></div>
  <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Purchase Date</label>
    <input type="date" name="purchase_date" value="<%= formatDate(record.purchase_date) %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></div>
  <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Total Amount</label>
    <input type="number" step="0.01" name="total_amount" value="<%= record.total_amount || '' %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></div>
  <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Currency</label>
    <input type="text" name="currency" value="<%= record.currency || 'USD' %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></div>
  <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Replace Invoice File</label>
    <input type="file" name="invoice" class="w-full text-xs text-slate-400"></div>
  <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Replace PO File</label>
    <input type="file" name="po" class="w-full text-xs text-slate-400"></div>
  <div class="sm:col-span-2"><label class="block text-xs font-medium text-slate-400 mb-1.5">Notes</label>
    <textarea name="notes" rows="3" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"><%= record.notes || '' %></textarea></div>
  <div class="sm:col-span-2 flex justify-end gap-2">
    <a href="<%= hams_url('/procurement/' + record.id) %>" class="px-5 py-2.5 rounded-xl bg-white/5 text-sm text-slate-300">Cancel</a>
    <button type="submit" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-sm text-white font-medium">Save Changes</button>
  </div>
</form>
</div>
