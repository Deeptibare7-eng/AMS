<div class="flex flex-wrap items-center justify-between gap-4 mb-8">
  <div>
    <h1 class="font-heading text-2xl md:text-3xl font-bold text-white">Procurement Ledger</h1>
    <p class="text-sm text-slate-500 mt-1">Purchase orders, invoices, and vendor records</p>
  </div>
  <a href="<%= hams_url('/procurement/create') %>" class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium"><i data-lucide="plus" class="w-4 h-4"></i>New Record</a>
</div>

<div class="bg-hams-card border border-white/5 rounded-3xl mb-6">
  <div class="flex flex-wrap items-center gap-3 p-4">
    <form method="GET" action="<%= hams_url('/procurement') %>" class="flex-1 min-w-[200px] relative">
      <i data-lucide="search" class="w-4 h-4 absolute left-4 top-1/2 -translate-y-1/2 text-slate-500"></i>
      <input type="text" name="search" value="<%= search %>" placeholder="Search PO, invoice, or vendor..."
             class="w-full pl-11 pr-10 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm outline-none focus:border-blue-500">
      <% if (search) { %><a href="<%= hams_url('/procurement') %>" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white">&times;</a><% } %>
    </form>
    <span class="text-xs text-slate-500"><%= total %> records</span>
  </div>
</div>
<div class="bg-hams-card border border-white/5 rounded-3xl overflow-hidden">
  <div class="table-responsive">
    <table class="w-full min-w-[900px] text-sm">
      <thead><tr class="text-left text-xs text-slate-500 uppercase border-b border-white/5">
        <th class="px-6 py-4">PO / Invoice</th><th class="px-6 py-4">Vendor</th><th class="px-6 py-4">Date</th><th class="px-6 py-4">Amount</th><th class="px-6 py-4">Files</th><th class="px-6 py-4 text-right">Actions</th>
      </tr></thead>
      <tbody class="divide-y divide-white/5">
        <% for (const r of records) { %>
        <tr class="hover:bg-white/[.02]">
          <td class="px-6 py-4"><div class="text-white font-mono"><%= r.po_number || '—' %></div><div class="text-xs text-slate-500 font-mono"><%= r.invoice_number || '' %></div></td>
          <td class="px-6 py-4 text-slate-400"><%= r.vendor_name || '—' %></td>
          <td class="px-6 py-4 text-slate-400"><%= formatDate(r.purchase_date) || '—' %></td>
          <td class="px-6 py-4 text-slate-400"><%= r.total_amount ? Number(r.total_amount).toFixed(2) + ' ' + (r.currency || 'USD') : '—' %></td>
          <td class="px-6 py-4">
            <% if (r.invoice_file_path) { %><a href="/<%= r.invoice_file_path %>" target="_blank" class="text-xs text-blue-400 hover:underline mr-2">Invoice</a><% } %>
            <% if (r.po_file_path) { %><a href="/<%= r.po_file_path %>" target="_blank" class="text-xs text-blue-400 hover:underline">PO</a><% } %>
            <% if (!r.invoice_file_path && !r.po_file_path) { %><span class="text-xs text-slate-600">—</span><% } %>
          </td>
          <td class="px-6 py-4">
            <div class="flex justify-end gap-1">
              <a href="<%= hams_url('/procurement/' + r.id) %>" class="p-2 rounded-lg hover:bg-white/5 text-slate-400"><i data-lucide="eye" class="w-4 h-4"></i></a>
              <a href="<%= hams_url('/procurement/' + r.id + '/edit') %>" class="p-2 rounded-lg hover:bg-white/5 text-slate-400"><i data-lucide="edit-3" class="w-4 h-4"></i></a>
            </div>
          </td>
        </tr>
        <% } %>
        <% if (!records.length) { %><tr><td colspan="6" class="px-6 py-12 text-center text-slate-500">No procurement records.</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <%- await include('../components/pagination', { paginator, baseUrl }) %>
</div>
