<div class="mb-8">
  <h1 class="font-heading text-2xl md:text-3xl font-bold text-white">Request Approvals</h1>
  <p class="text-sm text-slate-500 mt-1">Review employee asset requests — approving a request with an available asset auto-checks it out</p>
</div>

<div class="bg-hams-card border border-white/5 rounded-3xl overflow-hidden">
  <div class="table-responsive">
    <table class="w-full min-w-[1000px] text-sm">
      <thead><tr class="text-left text-xs text-slate-500 uppercase border-b border-white/5">
        <th class="px-6 py-4">Request</th><th class="px-6 py-4">User</th><th class="px-6 py-4">Target</th><th class="px-6 py-4">Status</th><th class="px-6 py-4">Review</th>
      </tr></thead>
      <tbody class="divide-y divide-white/5">
        <% const statusColors = { pending: 'amber', approved: 'emerald', fulfilled: 'blue', rejected: 'rose' }; %>
        <% for (const r of requests) { %>
        <tr class="hover:bg-white/[.02] align-top" x-data="{ showNotes: false, notes: '' }">
          <td class="px-6 py-4">
            <div class="text-white font-medium"><%= r.title %></div>
            <% if (r.business_justification) { %><div class="text-xs text-slate-500 max-w-xs"><%= r.business_justification %></div><% } %>
            <div class="text-xs text-slate-600 mt-1"><%= formatDateTime(r.created_at) %></div>
          </td>
          <td class="px-6 py-4 text-slate-300"><%= r.user_name %></td>
          <td class="px-6 py-4 text-slate-400"><%= r.asset_name ? r.asset_name + ' (' + r.asset_tag + ')' : (r.model_name || r.category_name || '—') %></td>
          <% const c = statusColors[r.status] || 'slate'; %>
          <td class="px-6 py-4">
            <span class="px-2.5 py-1 rounded-lg bg-<%= c %>-500/10 text-<%= c %>-400 text-xs capitalize"><%= r.status %></span>
            <% if (r.reviewer_name) { %><div class="text-xs text-slate-500 mt-1">by <%= r.reviewer_name %></div><% } %>
            <% if (r.review_notes) { %><div class="text-xs text-slate-500 mt-1 max-w-[180px]"><%= r.review_notes %></div><% } %>
          </td>
          <td class="px-6 py-4">
            <% if (r.status === 'pending') { %>
            <div class="space-y-2">
              <textarea x-model="notes" x-show="showNotes" x-cloak rows="2" placeholder="Review notes..." class="w-full px-3 py-2 rounded-lg bg-hams-bg border border-white/10 text-xs"></textarea>
              <div class="flex gap-2">
                <form method="POST" action="<%= hams_url('/requests/' + r.id + '/review') %>">
                  <%- csrf_field %>
                  <input type="hidden" name="status" value="approved">
                  <input type="hidden" name="review_notes" :value="notes">
                  <button class="px-3 py-1.5 rounded-lg bg-emerald-600/15 text-emerald-400 hover:bg-emerald-600/25 text-xs font-medium">Approve</button>
                </form>
                <form method="POST" action="<%= hams_url('/requests/' + r.id + '/review') %>">
                  <%- csrf_field %>
                  <input type="hidden" name="status" value="rejected">
                  <input type="hidden" name="review_notes" :value="notes">
                  <button class="px-3 py-1.5 rounded-lg bg-rose-600/15 text-rose-400 hover:bg-rose-600/25 text-xs font-medium">Reject</button>
                </form>
                <button @click="showNotes = !showNotes" class="px-2 py-1.5 rounded-lg bg-white/5 text-slate-400 text-xs">Notes</button>
              </div>
            </div>
            <% } else { %>
            <span class="text-xs text-slate-600">Reviewed <%= formatDate(r.reviewed_at) %></span>
            <% } %>
          </td>
        </tr>
        <% } %>
        <% if (!requests.length) { %><tr><td colspan="5" class="px-6 py-12 text-center text-slate-500">No requests to review.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
