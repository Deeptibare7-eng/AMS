<aside class="w-full lg:w-64 shrink-0 space-y-6">
  <div>
    <div class="px-3 mb-2 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Administrative Center</div>
    <% const adminLinks = [
      ['branding', 'Workspace & Branding', 'palette', '/settings/branding'],
      ['organization', 'Organization', 'building', '/settings/organization'],
      ['security', 'Security Center', 'shield', '/settings/security'],
      ['identity', 'Identity & Access', 'users', '/settings/identity'],
      ['roles', 'Roles & Permissions', 'shield-check', '/settings/roles'],
      ['modules', 'Feature Modules', 'layout-grid', '/settings/modules'],
      ['ai', 'AI', 'sparkles', '/settings/ai'],
      ['backups', 'Backup & Restore', 'database-backup', '/settings/backups'],
      ['notifications', 'Notifications', 'bell', '/settings/notifications'],
      ['inventory_setup', 'Inventory Setup', 'barcode', '/inventory-setup'],
      ['monitoring', 'Audit & Monitoring', 'activity', '/settings/monitoring']
    ]; %>
    <% for (const [key, label, icon, href] of adminLinks) { %>
    <a href="<%= hams_url(href) %>" class="flex items-center gap-3 px-3 py-2 rounded-xl text-sm <%= (typeof active_tab !== 'undefined' && active_tab === key) ? 'bg-blue-600/10 text-blue-500 font-medium' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
      <i data-lucide="<%= icon %>" class="w-4 h-4"></i><%= label %>
    </a>
    <% } %>
  </div>
  <div>
    <div class="px-3 mb-2 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Operations &amp; Governance</div>
    <% const opsLinks = [
      ['users', 'Enterprise Directory', 'users', '/users'],
      ['ldap_users', 'LDAP Users', 'network', '/users/ldap'],
      ['alerts', 'Alerts', 'triangle-alert', '/alerts'],
      ['notifications_center', 'Notification Center', 'bell-ring', '/notifications'],
      ['audit', 'Audit Trails', 'shield-check', '/audit'],
      ['archive', 'Archive', 'archive', '/archive'],
      ['advanced', 'Advanced Lifecycle', 'git-branch', '/advanced'],
      ['report_schedules', 'Report Schedules', 'calendar-clock', '/settings/report-schedules'],
      ['api_tokens', 'API Tokens', 'key-round', '/settings/api-tokens'],
      ['logs', 'Log Viewer', 'scroll-text', '/logs'],
      ['automations', 'Automations', 'workflow', '/settings/automations']
    ]; %>
    <% for (const [key, label, icon, href] of opsLinks) { %>
    <a href="<%= hams_url(href) %>" class="flex items-center gap-3 px-3 py-2 rounded-xl text-sm <%= (typeof active_tab !== 'undefined' && active_tab === key) ? 'bg-blue-600/10 text-blue-500 font-medium' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
      <i data-lucide="<%= icon %>" class="w-4 h-4"></i><%= label %>
    </a>
    <% } %>
  </div>
</aside>
