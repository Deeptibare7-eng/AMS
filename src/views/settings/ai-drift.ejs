<div class="flex flex-col lg:flex-row gap-8">
  <%- await include('_sidebar', { active_tab }) %>
  <div class="flex-1 min-w-0 space-y-6">
    <div>
      <a href="<%= hams_url('/settings/ai') %>#drift" class="text-xs text-slate-500 hover:text-slate-300">← AI settings</a>
      <h1 class="font-heading text-2xl font-bold text-white mt-1 mb-1">Drift report</h1>
      <p class="text-sm text-slate-500">How far today's register has moved from the data each model learnt from. PSI (population stability index) compares the shares of each feature's values: under <%= bands.moderate %> stable, <%= bands.moderate %>–<%= bands.significant %> moderate, over <%= bands.significant %> significant. For numbers, the KS test says how likely so big a difference would be by chance (a small p means a real change).</p>
    </div>

    <div class="flex flex-wrap items-center gap-3 text-xs text-slate-400">
      <% if (job) { const s = job.state; %>
      <span>Checked daily at 05:30 (<%= job.enabled ? 'on' : 'off: switch on Intake, Data health, Refresh risk or Cost forecast' %>)<%= s && s.last_run_at ? ' · last run ' + formatDateTime(s.last_run_at) : '' %></span>
      <form method="POST" action="<%= hams_url('/settings/ai/jobs/ai_drift/run') %>"><%- csrf_field %><button <%= job.enabled ? '' : 'disabled' %> class="px-3 py-1.5 rounded-xl <%= job.enabled ? 'bg-white/5 hover:bg-white/10 text-slate-300' : 'bg-white/5 text-slate-600 cursor-not-allowed' %>">Check now</button></form>
      <% } %>
    </div>

    <% if (!models.length) { %>
    <div class="bg-hams-card border border-white/5 rounded-3xl p-10 text-center text-sm text-slate-500">No drift check yet.</div>
    <% } %>

    <% const ST = { stable: ['emerald', 'check-circle-2', 'Stable'], moderate: ['amber', 'alert-triangle', 'Moderate'], significant: ['rose', 'alert-octagon', 'Significant'] }; %>
    <% for (const m of models) { const st = ST[m.status] || ST.stable; const scale = Math.max(0.5, ...((m.features || []).map(f => f.psi))); %>
    <div class="bg-hams-card border border-white/5 rounded-3xl p-6">
      <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
        <div>
          <h2 class="font-heading font-semibold text-white"><%= m.label %> <span class="text-sm text-slate-500 font-normal">v<%= m.model_version %></span></h2>
          <p class="text-xs text-slate-500 mt-1">Checked <%= formatDateTime(m.checked_at) %> · reference <%= m.baseline_at ? formatDateTime(m.baseline_at) : '—' %> (<%= Number(m.baseline_rows || 0).toLocaleString('en-IN') %> assets) · today <%= Number(m.current_rows || 0).toLocaleString('en-IN') %> assets</p>
          <% if (m.action) { %><p class="text-xs text-slate-400 mt-1"><%= m.action %></p><% } %>
        </div>
        <span class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-<%= st[0] %>-500/10 text-<%= st[0] %>-400 flex items-center gap-1.5"><i data-lucide="<%= st[1] %>" class="w-3.5 h-3.5"></i><%= st[2] %> · max PSI <%= Number(m.max_psi).toFixed(2) %></span>
      </div>

      <% if ((m.features || []).length) { %>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[680px] text-sm">
          <thead><tr class="text-left text-xs text-slate-500">
            <th class="py-2 pr-4">Feature</th><th class="py-2 pr-4 w-[24%]">PSI</th><th class="py-2 pr-4 text-right whitespace-nowrap">KS D · p</th><th class="py-2 pr-4">What moved</th><th class="py-2 whitespace-nowrap">Status</th>
          </tr></thead>
          <tbody>
            <% for (const f of m.features) { const fs = ST[f.status] || ST.stable; const w = Math.min(100, (f.psi / scale) * 100); %>
            <tr class="border-t border-white/5">
              <td class="py-2.5 pr-4 text-slate-200"><%= f.feature %><div class="text-[10px] text-slate-600"><%= f.discrete ? 'number with few values' : f.kind === 'num' ? 'number' : 'category' %></div></td>
              <td class="py-2.5 pr-4">
                <div class="flex items-center gap-3">
                  <%# A thin bar on a 0–scale axis, with marks at the moderate and significant bands. %>
                  <div class="relative flex-1 min-w-[96px] h-2 rounded-full bg-white/5" title="PSI <%= f.psi.toFixed(3) %> (<%= fs[2].toLowerCase() %>)">
                    <div class="absolute inset-y-0 left-0 rounded-full bg-<%= fs[0] %>-500" style="width: <%= Math.max(1, w).toFixed(1) %>%"></div>
                    <div class="absolute -top-1 -bottom-1 w-px bg-slate-500/60" style="left: <%= (bands.moderate / scale * 100).toFixed(1) %>%"></div>
                    <div class="absolute -top-1 -bottom-1 w-px bg-slate-400/80" style="left: <%= (bands.significant / scale * 100).toFixed(1) %>%"></div>
                  </div>
                  <span class="w-11 text-right text-slate-200 tabular-nums"><%= f.psi >= 10 ? f.psi.toFixed(1) : f.psi.toFixed(2) %></span>
                </div>
              </td>
              <td class="py-2.5 pr-4 text-right text-slate-400 tabular-nums whitespace-nowrap"><%= f.ks_d === null ? '—' : f.ks_d.toFixed(2) + ' · ' + (f.ks_p < 0.001 ? '<0.001' : f.ks_p.toFixed(3)) %></td>
              <td class="py-2.5 pr-4 text-xs text-slate-400 max-w-[22rem]"><%= (f.shifts || []).join(' · ') || '—' %></td>
              <td class="py-2.5 whitespace-nowrap"><span class="inline-flex items-center gap-1 text-xs text-<%= fs[0] %>-400"><i data-lucide="<%= fs[1] %>" class="w-3.5 h-3.5"></i><%= fs[2] %></span></td>
            </tr>
            <% } %>
          </tbody>
        </table>
        <p class="text-[11px] text-slate-500 mt-2">Bars run from 0 to <%= scale.toFixed(2) %>; the two marks are <%= bands.moderate %> and <%= bands.significant %>.</p>
      </div>
      <% } else { %><p class="text-sm text-slate-500">The reference was recorded at this check; the next check compares with it.</p><% } %>

      <% if (m.history.length > 1) { %>
      <details class="mt-4">
        <summary class="cursor-pointer text-xs text-slate-400">History (<%= m.history.length %> checks)</summary>
        <div class="overflow-x-auto mt-2">
          <table class="w-full text-xs">
            <thead><tr class="text-left text-slate-500"><th class="py-1 pr-4">Checked</th><th class="py-1 pr-4">Version</th><th class="py-1 pr-4 text-right">Max PSI</th><th class="py-1 pr-4">Status</th><th class="py-1">What was done</th></tr></thead>
            <tbody>
              <% for (const h of m.history) { const hs = ST[h.status] || ST.stable; %><tr class="border-t border-white/5"><td class="py-1.5 pr-4 text-slate-400 whitespace-nowrap"><%= formatDateTime(h.checked_at) %></td><td class="py-1.5 pr-4 text-slate-400">v<%= h.model_version %></td><td class="py-1.5 pr-4 text-right text-slate-300 tabular-nums"><%= Number(h.max_psi).toFixed(3) %></td><td class="py-1.5 pr-4 text-<%= hs[0] %>-400"><%= hs[2] %></td><td class="py-1.5 text-slate-500"><%= h.action || '' %></td></tr><% } %>
            </tbody>
          </table>
        </div>
      </details>
      <% } %>
    </div>
    <% } %>
  </div>
</div>
