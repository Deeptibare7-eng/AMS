<div class="flex flex-col lg:flex-row gap-8">
  <%- await include('_sidebar', { active_tab }) %>
  <div class="flex-1">
    <h1 class="font-heading text-2xl font-bold text-white mb-1">Feature Modules</h1>
    <p class="text-sm text-slate-500 mb-6">Enable or disable platform capabilities. Settings and Personnel modules are protected.</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% for (const m of modules) { %>
      <div class="bg-hams-card border border-white/5 rounded-3xl p-6">
        <div class="flex items-start justify-between mb-3">
          <span class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center"><i data-lucide="<%= m.icon %>" class="w-5 h-5"></i></span>
          <span class="px-2.5 py-1 rounded-lg text-xs font-semibold <%= m.is_active ? 'bg-emerald-500/10 text-emerald-400' : 'bg-slate-500/10 text-slate-500' %>"><%= m.is_active ? 'Active' : 'Disabled' %></span>
        </div>
        <div class="font-semibold text-white"><%= m.label %></div>
        <div class="text-xs font-mono text-slate-600 mb-2"><%= m.name %></div>
        <p class="text-xs text-slate-500 mb-4"><%= m.description || '' %></p>
        <form method="POST" action="<%= hams_url('/settings/modules/' + m.id + '/toggle') %>">
          <%- csrf_field %>
          <% const protectedMod = ['settings', 'personnel'].includes(m.name); %>
          <button <%= protectedMod ? 'disabled' : '' %>
                  class="px-4 py-2 rounded-xl text-xs font-medium <%= protectedMod ? 'bg-white/5 text-slate-600 cursor-not-allowed' : (m.is_active ? 'bg-rose-500/10 text-rose-400 hover:bg-rose-500/20' : 'bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20') %>">
            <%= protectedMod ? 'Protected' : (m.is_active ? 'Disable Module' : 'Enable Module') %>
          </button>
        </form>
      </div>
      <% } %>
    </div>
  </div>
</div>
