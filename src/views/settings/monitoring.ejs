<% const sv = (k, d = '') => (settings[k] ? (settings[k].value ?? d) : d); %>
<div class="flex flex-col lg:flex-row gap-8">
  <%- await include('_sidebar', { active_tab }) %>
  <div class="flex-1 max-w-3xl space-y-6">
    <div>
      <h1 class="font-heading text-2xl font-bold text-white mb-1">Audit &amp; Monitoring</h1>
      <p class="text-sm text-slate-500">Platform health snapshot and retention policies</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-hams-card border border-white/5 rounded-2xl p-5">
        <div class="text-xs text-slate-500 mb-1">Database</div>
        <div class="text-sm font-semibold <%= snapshot.db.status === 'OPTIMAL' ? 'text-emerald-400' : 'text-rose-400' %>"><%= snapshot.db.status %></div>
      </div>
      <div class="bg-hams-card border border-white/5 rounded-2xl p-5">
        <div class="text-xs text-slate-500 mb-1">Backups</div>
        <div class="text-sm font-semibold <%= snapshot.backups.status === 'READY' ? 'text-emerald-400' : 'text-amber-400' %>"><%= snapshot.backups.status %> (<%= snapshot.backups.count %>)</div>
      </div>
      <div class="bg-hams-card border border-white/5 rounded-2xl p-5">
        <div class="text-xs text-slate-500 mb-1">LDAP</div>
        <div class="text-sm font-semibold text-amber-400"><%= snapshot.ldap.message %></div>
      </div>
    </div>

    <form method="POST" action="<%= hams_url('/settings/update') %>" class="bg-hams-card border border-white/5 rounded-3xl p-6 space-y-4">
      <%- csrf_field %>
      <input type="hidden" name="group" value="monitoring">
      <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Audit Retention (days)</label>
        <input type="number" name="audit_retention_days" value="<%= sv('audit_retention_days', '365') %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></div>
      <label class="flex items-center gap-3 text-sm"><input type="checkbox" name="health_alerts_enabled" value="1" <%= sv('health_alerts_enabled', '1') === '1' ? 'checked' : '' %> class="rounded"><span class="text-slate-300">Enable health alerts</span></label>
      <button type="submit" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium">Save Monitoring Settings</button>
    </form>

    <div class="bg-hams-card border border-white/5 rounded-3xl overflow-hidden">
      <h2 class="font-heading font-semibold text-white px-6 pt-6 pb-4">Recent Events</h2>
      <table class="w-full text-sm">
        <thead><tr class="text-left text-xs text-slate-500 uppercase border-b border-white/5">
          <th class="px-6 py-3">Event</th><th class="px-6 py-3">Source</th><th class="px-6 py-3">Timestamp</th>
        </tr></thead>
        <tbody class="divide-y divide-white/5">
          <% for (const log of snapshot.logs) { %>
          <tr><td class="px-6 py-3 text-white"><%= log.action %></td><td class="px-6 py-3 text-slate-400"><%= log.user_name || 'System' %></td><td class="px-6 py-3 text-slate-500"><%= formatDateTime(log.created_at) %></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
