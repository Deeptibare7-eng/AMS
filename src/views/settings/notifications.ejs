<% const sv = (k, d = '') => (settings[k] ? (settings[k].value ?? d) : d); %>
<div class="flex flex-col lg:flex-row gap-8">
  <%- await include('_sidebar', { active_tab }) %>
  <div class="flex-1 max-w-2xl">
    <h1 class="font-heading text-2xl font-bold text-white mb-1">Notifications &amp; Automation</h1>
    <p class="text-sm text-slate-500 mb-6">Email delivery and outbound webhook configuration</p>
    <form method="POST" action="<%= hams_url('/settings/update') %>" class="bg-hams-card border border-white/5 rounded-3xl p-6 space-y-4">
      <%- csrf_field %>
      <input type="hidden" name="group" value="notifications">
      <label class="flex items-center gap-3 text-sm"><input type="checkbox" name="email_enabled" value="1" <%= sv('email_enabled') === '1' ? 'checked' : '' %> class="rounded"><span class="font-medium text-white">Enable Email Notifications</span></label>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% const smtp = [['smtp_host', 'SMTP Host'], ['smtp_port', 'SMTP Port'], ['smtp_username', 'SMTP Username'], ['smtp_password', 'SMTP Password'], ['mail_from', 'From Address']]; %>
        <% for (const [name, label] of smtp) { %>
        <div><label class="block text-xs font-medium text-slate-400 mb-1.5"><%= label %></label>
          <input type="<%= name.includes('password') ? 'password' : 'text' %>" name="<%= name %>" value="<%= name.includes('password') ? '' : sv(name) %>"<% if (name.includes('password')) { %> autocomplete="new-password" placeholder="<%= sv(name) ? '(saved — leave blank to keep)' : '' %>"<% } %> class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></div>
        <% } %>
        <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Encryption</label>
          <select name="smtp_encryption" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
            <% for (const enc of ['tls', 'ssl', 'none']) { %><option value="<%= enc %>" <%= sv('smtp_encryption', 'tls') === enc ? 'selected' : '' %>><%= enc %></option><% } %>
          </select></div>
      </div>
      <label class="flex items-center gap-3 text-sm"><input type="checkbox" name="backup_failure_email" value="1" <%= sv('backup_failure_email', '1') === '1' ? 'checked' : '' %> class="rounded"><span class="text-slate-300">Email administrators on backup failure</span></label>
      <div class="border-t border-white/5 pt-4">
        <label class="flex items-center gap-3 text-sm mb-3"><input type="checkbox" name="webhook_enabled" value="1" <%= sv('webhook_enabled') === '1' ? 'checked' : '' %> class="rounded"><span class="font-medium text-white">Enable Notification Webhook</span></label>
        <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Webhook URL</label>
          <input type="text" name="webhook_url" value="<%= sv('webhook_url') %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></div>
      </div>
      <button type="submit" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium">Save Notification Settings</button>
    </form>
    <form method="POST" action="<%= hams_url('/settings/notifications/test-email') %>" class="mt-4 bg-hams-card border border-white/5 rounded-3xl p-6 flex flex-wrap items-center justify-between gap-3">
      <%- csrf_field %>
      <div>
        <div class="text-sm font-medium text-white">Send test email</div>
        <div class="text-xs text-slate-500">Sends a test message to your own address (<%= currentUser.email %>) using the saved settings above.</div>
      </div>
      <button class="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-sm text-slate-300 flex items-center gap-2"><i data-lucide="send" class="w-4 h-4"></i>Send test</button>
    </form>
  </div>
</div>
