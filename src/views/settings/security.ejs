<% const sv = (k, d = '') => (settings[k] ? (settings[k].value ?? d) : d); %>
<div class="flex flex-col lg:flex-row gap-8">
  <%- await include('_sidebar', { active_tab }) %>
  <div class="flex-1 max-w-2xl">
    <h1 class="font-heading text-2xl font-bold text-white mb-1">Security Center</h1>
    <p class="text-sm text-slate-500 mb-6">Authentication and password policies</p>
    <form method="POST" action="<%= hams_url('/settings/update') %>" class="bg-hams-card border border-white/5 rounded-3xl p-6 space-y-4">
      <%- csrf_field %>
      <input type="hidden" name="group" value="security">
      <label class="flex items-center gap-3 text-sm text-slate-300 py-2">
        <input type="checkbox" name="two_factor_system_enabled" value="1" <%= sv('two_factor_system_enabled') === '1' ? 'checked' : '' %> class="rounded">
        <span><span class="font-medium text-white">Enable Two-Factor Authentication System</span><br><span class="text-xs text-slate-500">Allow users to enable TOTP-based 2FA and require it at login for enrolled users.</span></span>
      </label>
      <label class="flex items-center gap-3 text-sm text-slate-300 py-2">
        <input type="checkbox" name="mfa_required" value="1" <%= sv('mfa_required') === '1' ? 'checked' : '' %> class="rounded">
        <span class="font-medium text-white">Require MFA for all users</span>
      </label>
      <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Session Timeout (seconds)</label>
        <input type="number" name="session_timeout" value="<%= sv('session_timeout', '3600') %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></div>
      <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Minimum Password Length</label>
        <input type="number" name="pwd_min_length" value="<%= sv('pwd_min_length', '12') %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></div>
      <label class="flex items-center gap-3 text-sm text-slate-300 py-2">
        <input type="checkbox" name="pwd_special" value="1" <%= sv('pwd_special') === '1' ? 'checked' : '' %> class="rounded">
        <span class="font-medium text-white">Require special characters in passwords</span>
      </label>
      <button type="submit" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium">Save Security Settings</button>
    </form>
  </div>
</div>
