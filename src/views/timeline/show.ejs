<div class="max-w-3xl">
<div class="mb-8">
  <h1 class="font-heading text-2xl md:text-3xl font-bold text-white">Record Timeline</h1>
  <p class="text-sm text-slate-500 mt-1 capitalize"><%= module %> #<%= id %></p>
</div>

<div class="relative pl-8">
  <div class="absolute left-3 top-0 bottom-0 w-px bg-white/10"></div>
  <div class="space-y-6">
    <% for (const ev of events) { %>
    <div class="relative">
      <span class="absolute -left-8 top-0 w-6 h-6 rounded-full bg-hams-card border border-white/10 flex items-center justify-center"><i data-lucide="activity" class="w-3 h-3 text-blue-400"></i></span>
      <div class="bg-hams-card border border-white/5 rounded-2xl p-4">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
          <span class="text-sm font-semibold text-white"><%= ev.title %></span>
          <span class="text-xs text-slate-500"><%= ev.actor %> · <%= formatDateTime(ev.created_at) %></span>
        </div>
        <p class="text-sm text-slate-400"><%= ev.description || '' %></p>
      </div>
    </div>
    <% } %>
    <% if (!events.length) { %><p class="text-sm text-slate-500">No events recorded for this item.</p><% } %>
  </div>
</div>
</div>
