<div class="max-w-md mx-auto">
<div class="bg-hams-card border border-white/5 rounded-3xl p-8 text-center">
  <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-emerald-500/15 text-emerald-400 flex items-center justify-center"><i data-lucide="shield-check" class="w-7 h-7"></i></div>
  <h1 class="font-heading text-xl font-bold text-white mb-1">Set Up Two-Factor Authentication</h1>
  <p class="text-sm text-slate-500 mb-6">Scan the QR code with your authenticator app, then enter the 6-digit code.</p>
  <div class="bg-white p-3 rounded-2xl inline-block mb-4"><img src="<%= qrCodeUrl %>" width="200" height="200" alt="QR"></div>
  <div class="text-xs text-slate-500 mb-1">Manual entry key</div>
  <div class="font-mono text-sm text-white bg-white/5 rounded-lg px-3 py-2 mb-6 select-all"><%= secret %></div>
  <form method="POST" action="<%= hams_url('/profile/2fa/enable') %>" class="space-y-4">
    <%- csrf_field %>
    <input type="hidden" name="secret" value="<%= secret %>">
    <input type="text" name="code" maxlength="6" autofocus
           class="w-full px-4 py-3 rounded-xl bg-hams-bg border border-white/10 text-center text-xl tracking-[0.4em] font-mono">
    <button type="submit" class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold">Verify &amp; Enable</button>
  </form>
  <a href="<%= hams_url('/profile') %>" class="inline-block mt-4 text-xs text-slate-500 hover:text-slate-300">Cancel</a>
</div>
</div>
