<div class="max-w-3xl">
<div class="flex items-center gap-3 mb-8">
  <a href="<%= hams_url('/users/' + user.id) %>" class="p-2 rounded-xl hover:bg-white/5 text-slate-400"><i data-lucide="arrow-left" class="w-5 h-5"></i></a>
  <h1 class="font-heading text-2xl md:text-3xl font-bold text-white">Edit User</h1>
</div>

<form method="POST" action="<%= hams_url('/users/' + user.id + '/update') %>" class="bg-hams-card border border-white/5 rounded-3xl p-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
  <%- csrf_field %>
  <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Full Name *</label>
    <input type="text" name="name" required value="<%= user.name %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></div>
  <% const emailOptional = user.role === 'employee'; %>
  <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Email<%= emailOptional ? ' (optional for employees)' : ' *' %></label>
    <input type="email" name="email" <%= emailOptional ? '' : 'required' %> value="<%= user.email || '' %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></div>
  <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Employee ID</label>
    <input type="text" name="employee_id" value="<%= user.employee_id || '' %>" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></div>
  <div><label class="block text-xs font-medium text-slate-400 mb-1.5">New Password (leave blank to keep)</label>
    <input type="password" name="password" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm"></div>
  <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Role</label>
    <select name="role" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
      <% for (const r of references.roles) { %><option value="<%= r.name %>" <%= user.role === r.name ? 'selected' : '' %>><%= r.display_name || r.name %></option><% } %>
    </select></div>
  <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Status</label>
    <select name="status" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
      <% for (const s of ['active', 'suspended', 'pending', 'archived']) { %><option value="<%= s %>" <%= user.status === s ? 'selected' : '' %>><%= s %></option><% } %>
    </select></div>
  <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Department</label>
    <select name="department_id" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
      <option value="">— None —</option>
      <% for (const d of references.departments) { %><option value="<%= d.id %>" <%= String(user.department_id) === String(d.id) ? 'selected' : '' %>><%= d.name %></option><% } %>
    </select></div>
  <div><label class="block text-xs font-medium text-slate-400 mb-1.5">Location</label>
    <select name="location_id" class="w-full px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm">
      <option value="">— None —</option>
      <% for (const l of references.locations) { %><option value="<%= l.id %>" <%= String(user.location_id) === String(l.id) ? 'selected' : '' %>><%= l.name %></option><% } %>
    </select></div>
  <div class="sm:col-span-2 flex flex-wrap gap-6 pt-2">
    <label class="flex items-center gap-2 text-sm text-slate-300">
      <input type="hidden" name="two_factor_enabled" value="0">
      <input type="checkbox" name="two_factor_enabled" value="1" <%= user.two_factor_enabled ? 'checked' : '' %> class="rounded">Two-Factor Enabled
    </label>
    <label class="flex items-center gap-2 text-sm text-slate-300">
      <input type="checkbox" name="reset_two_factor" value="1" class="rounded">Reset Two-Factor Secret
    </label>
  </div>
  <div class="sm:col-span-2 flex justify-end gap-2 pt-2">
    <a href="<%= hams_url('/users/' + user.id) %>" class="px-5 py-2.5 rounded-xl bg-white/5 text-sm text-slate-300">Cancel</a>
    <button type="submit" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-sm text-white font-medium">Save Changes</button>
  </div>
</form>
</div>
