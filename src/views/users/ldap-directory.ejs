<div class="flex flex-wrap items-center justify-between gap-4 mb-8">
  <div>
    <h1 class="font-heading text-2xl md:text-3xl font-bold text-white">LDAP Directory Users</h1>
    <p class="text-sm text-slate-500 mt-1">Synchronized directory accounts and portal access control</p>
  </div>
  <form method="POST" action="<%= hams_url('/users/ldap/sync') %>" class="flex gap-2">
    <%- csrf_field %>
    <select name="sync_type" class="px-3 py-2.5 rounded-xl bg-hams-card border border-white/10 text-sm">
      <option value="auto">Auto</option><option value="full">Full</option><option value="incremental">Incremental</option>
    </select>
    <button class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium"><i data-lucide="refresh-cw" class="w-4 h-4"></i>Run Sync</button>
  </form>
</div>

<form method="GET" class="mb-4 flex flex-wrap gap-3">
  <input type="text" name="search" value="<%= filters.search %>" placeholder="Search name, email, username..." class="flex-1 min-w-[200px] px-4 py-2.5 rounded-xl bg-hams-card border border-white/10 text-sm">
  <div class="w-full sm:w-52">
    <%- await include('../components/multiselect', { name: 'status', label: 'Statuses', options: ['active', 'missing', 'disabled'].map(s => ({ value: s, label: s })), selected: filters.status }) %>
  </div>
  <button class="px-5 py-2.5 rounded-xl bg-white/5 text-sm text-slate-300">Filter</button>
</form>

<div class="bg-hams-card border border-white/5 rounded-3xl overflow-hidden mb-6">
  <div class="table-responsive">
    <table class="w-full min-w-[900px] text-sm">
      <thead><tr class="text-left text-xs text-slate-500 uppercase border-b border-white/5">
        <th class="px-6 py-4">Directory Identity</th><th class="px-6 py-4">Organization</th><th class="px-6 py-4">Portal Access</th><th class="px-6 py-4">Sync</th><th class="px-6 py-4 text-right">Actions</th>
      </tr></thead>
      <tbody class="divide-y divide-white/5">
        <% for (const u of users) { %>
        <tr>
          <td class="px-6 py-4"><div class="text-white font-medium"><%= u.display_name %></div><div class="text-xs text-slate-500"><%= u.email || u.username || u.dn %></div></td>
          <td class="px-6 py-4 text-slate-400"><%= u.department || '—' %><%= u.title ? ' · ' + u.title : '' %></td>
          <td class="px-6 py-4">
            <form method="POST" action="<%= hams_url('/users/ldap/' + u.id + '/update') %>" class="flex items-center gap-2">
              <%- csrf_field %>
              <input type="hidden" name="can_login" value="0">
              <label class="flex items-center gap-1.5 text-xs text-slate-300"><input type="checkbox" name="can_login" value="1" <%= u.can_login ? 'checked' : '' %> class="rounded">Login</label>
              <select name="role_name" class="px-2 py-1 rounded-lg bg-hams-bg border border-white/10 text-xs">
                <% for (const r of roles) { %><option value="<%= r.name %>" <%= u.role_name === r.name ? 'selected' : '' %>><%= r.display_name || r.name %></option><% } %>
              </select>
              <button class="px-2 py-1 rounded-lg bg-blue-600/20 text-blue-400 text-xs">Save</button>
            </form>
          </td>
          <td class="px-6 py-4"><span class="px-2 py-0.5 rounded text-xs bg-white/5 text-slate-400"><%= u.sync_status %></span></td>
          <td class="px-6 py-4 text-right text-xs text-slate-500"><%= u.local_user_name ? 'Linked: ' + u.local_user_name : 'Not linked' %></td>
        </tr>
        <% } %>
        <% if (!users.length) { %><tr><td colspan="5" class="px-6 py-12 text-center text-slate-500">No directory users. Configure and enable LDAP under Settings &gt; Identity, then run a sync.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="bg-hams-card border border-white/5 rounded-3xl p-6">
  <h2 class="font-heading font-semibold text-white mb-4">Recent Sync Jobs</h2>
  <div class="space-y-2">
    <% for (const j of jobs) { %>
    <div class="flex items-center justify-between p-3 rounded-xl bg-white/[.02] text-sm">
      <span class="text-slate-300 capitalize"><%= j.sync_type %> sync — <%= j.status %></span>
      <span class="text-xs text-slate-500">Seen <%= j.total_seen %> · Created <%= j.created_count %> · Updated <%= j.updated_count %> · <%= formatDateTime(j.started_at) %></span>
    </div>
    <% } %>
    <% if (!jobs.length) { %><p class="text-sm text-slate-500">No sync jobs have run.</p><% } %>
  </div>
</div>
